+import { describe, expect, it } from 'vitest';
+import { TRACE_PRESETS } from '../../core/trace';
+import { tracePreviewFacts, type TraceDetectionRequest } from './use-trace-preview-facts';
+
+const SHARP = TRACE_PRESETS['Sharp']!;
+const traced: TraceDetectionRequest = {
+  file: new File(['image'], 'logo.png'),
+  options: SHARP,
+  boundary: { x: 0, y: 0, width: 8, height: 8 },
+  boundaryMode: 'crop',
+};
+const report = { automaticThresholdLuma: 118 };
+
+describe('what the settings panel may say about the finished preview', () => {
+  it('keeps the report while only finishing controls change', () => {
+    for (const change of [
+      { smoothness: 0.3 },
+      { optimize: 1 },
+      { ignoreLessThanPixels: 9 },
+      { centerlineJoinGapPx: 0 },
+    ]) {
+      const current = {
+        ...traced,
+        options: { ...SHARP, ...change },
+        boundary: { ...traced.boundary! },
+      };
+      expect(tracePreviewFacts({ request: traced, report }, current)).toEqual({ report });
+    }
+  });
+
+  it('withdraws the report when detection, the region or the image changes', () => {
+    for (const current of [
+      { ...traced, options: { ...SHARP, despeckleMinPixels: 5 } },
+      { ...traced, options: { ...SHARP, useOtsuThreshold: false, thresholdLuma: 90 } },
+      { ...traced, boundary: { x: 0, y: 0, width: 4, height: 8 } },
+      { ...traced, boundaryMode: 'enhance' as const },
+      { ...traced, file: new File(['image'], 'logo.png') },
+    ]) {
+      expect(tracePreviewFacts({ request: traced, report }, current)).toEqual({});
+    }
+  });
+});
diff --git a/src/ui/trace/use-trace-preview-facts.ts b/src/ui/trace/use-trace-preview-facts.ts
