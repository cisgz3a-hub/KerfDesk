index 000000000..ab0f9ba7f
--- /dev/null
+++ b/src/ui/trace/use-trace-preview-facts.ts
@@ -0,0 +1,75 @@
+// What the settings panel may say about the latest finished preview. Its
+// report (the automatic threshold, whether Line Art added pale detail) belongs
+// to one detection: it stays while only finishing controls change, so the
+// panel does not flicker on every curve tweak, and it is withdrawn as soon as
+// anything that decides detection differs from the traced request.
+
+import { useRef } from 'react';
+import type { TraceOptions, TraceReport } from '../../core/trace';
+import { sameBoundary, type TracePreparationRequest } from './prepared-trace';
+import type { TracePreviewState } from './use-trace-preview';
+
+export type TracePreviewFacts = {
+  readonly report?: TraceReport;
+};
+
+export type TraceDetectionRequest = Pick<
+  TracePreparationRequest,
+  'file' | 'options' | 'boundary' | 'boundaryMode'
+>;
+
+export type FinishedTracePreview = {
+  readonly request: TraceDetectionRequest;
+  readonly report?: TraceReport | undefined;
+};
+
+export function useTracePreviewFacts(
+  preview: TracePreviewState,
+  file: File | null,
+  options: TraceOptions,
+  selection: Pick<TraceDetectionRequest, 'boundary' | 'boundaryMode'>,
+): TracePreviewFacts {
+  const finished = useRef<FinishedTracePreview | null>(null);
+  if (preview.kind === 'ready' && preview.preparedTrace !== undefined) {
+    finished.current = { request: preview.preparedTrace.request, report: preview.report };
+  }
+  const current =
+    file === null
+      ? null
+      : { file, options, boundary: selection.boundary, boundaryMode: selection.boundaryMode };
+  return tracePreviewFacts(finished.current, current);
+}
+
+export function tracePreviewFacts(
+  finished: FinishedTracePreview | null,
+  current: TraceDetectionRequest | null,
+): TracePreviewFacts {
+  if (finished?.report === undefined || current === null) return {};
+  return sameDetection(finished.request, current) ? { report: finished.report } : {};
+}
+
+function sameDetection(a: TraceDetectionRequest, b: TraceDetectionRequest): boolean {
+  return (
+    a.file === b.file &&
+    sameBoundary(a.boundary, b.boundary) &&
+    a.boundaryMode === b.boundaryMode &&
+    (a.options === b.options || detectionKey(a.options) === detectionKey(b.options))
+  );
+}
+
+// Curve finishing, the traced-shape area filter and Centerline's gap joining
+// act on ink that detection has already chosen.
+const FINISHING_OPTION_KEYS: ReadonlySet<string> = new Set([
+  'smoothness',
+  'optimize',
+  'ignoreLessThanPixels',
+  'centerlineJoinGapPx',
+]);
+
+function detectionKey(options: TraceOptions): string {
+  const entries = Object.entries(options).filter(
+    ([key, value]) => value !== undefined && !FINISHING_OPTION_KEYS.has(key),
+  );
+  entries.sort(([a], [b]) => (a < b ? -1 : 1));
+  return JSON.stringify(entries);
+}
