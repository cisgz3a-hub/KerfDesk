+// Trace dialog copy and state that must match what the engine does (ADR-396).
+
+import { describe, expect, it, vi } from 'vitest';
+
+vi.mock('./image-loader', () => ({
+  PREVIEW_MAX_EDGE_PX: 2048,
+  loadImageAsRawData: vi.fn(async () => ({
+    width: 2,
+    height: 2,
+    data: new Uint8ClampedArray([
+      255, 255, 255, 255, 0, 0, 0, 255, 255, 255, 255, 255, 0, 0, 0, 255,
+    ]),
+  })),
+}));
+vi.mock('./use-trace-worker-client', () => ({
+  traceImageWithFallback: vi.fn(async () => ({
+    paths: [{ color: '#000000', polylines: [] }],
+    bounds: { minX: 0, minY: 0, maxX: 1, maxY: 1 },
+    width: 2,
+    height: 2,
+  })),
+}));
+
+import { changeSelect, selectByLabel, withTraceDialog } from './trace-dialog.test-support';
+
+describe('Trace dialog describes what each style engraves', () => {
+  it('calls Edge Detection line outlines in the style label and both output hints', async () => {
+    await withTraceDialog(async (host) => {
+      const text = (): string => host.textContent ?? '';
+      expect(text()).toContain('Filled shapes');
+      await changeSelect(selectByLabel(host, 'Trace preset'), 'Edge Detection');
+      expect(text()).toContain('Outline paths');
+      expect(text()).not.toContain('Filled shapes');
+      expect(text()).toContain(
+        'Editable outline paths, engraved along each line with a Line operation.',
+      );
+      await changeSelect(selectByLabel(host, 'Trace output'), 'raster');
+      expect(text()).toContain('their insides stay unburned');
+    });
+  });
+});
