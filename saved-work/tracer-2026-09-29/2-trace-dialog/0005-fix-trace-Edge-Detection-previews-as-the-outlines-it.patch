+// Trace dialog state that does not own trace requests or commits. Split from
+// ImportImageDialog.tsx to keep its render function inside the size caps.
+
+import { useState, type ComponentProps } from 'react';
+import type { TraceOptions } from '../../core/trace';
+import type { TraceFillStyle, TraceOutput, TraceOutputFields } from './dialog-parts';
+import type { TracePreviewState } from './use-trace-preview';
+
+export function isFilledContourTraceOptions(options: TraceOptions): boolean {
+  return options.traceMode !== 'centerline' && options.traceMode !== 'edge';
+}
+
+export function traceSourceHasTransparency(preview: TracePreviewState): boolean | undefined {
+  return preview.kind === 'tracing' || preview.kind === 'ready'
+    ? preview.sourceHasTransparency
+    : undefined;
+}
+
+/** The Output section's choices. CNC always commits vectors. */
+export function useTraceOutputChoice(
+  machineKind: 'laser' | 'cnc',
+  options: TraceOptions,
+): {
+  readonly traceOutput: TraceOutput;
+  readonly traceFillStyle: TraceFillStyle;
+  readonly fields: ComponentProps<typeof TraceOutputFields>;
+} {
+  const [traceFillStyle, setTraceFillStyle] = useState<TraceFillStyle>('scanline');
+  const [traceOutput, setTraceOutput] = useState<TraceOutput>('vector');
+  return {
+    traceOutput: machineKind === 'cnc' ? 'vector' : traceOutput,
+    traceFillStyle,
+    fields: {
+      photoShading: options.photoDetail !== undefined,
+      traceMode: options.traceMode,
+      machineKind,
+      traceOutput,
+      onTraceOutputChange: setTraceOutput,
+      supportsFillStyle: isFilledContourTraceOptions(options),
+      traceFillStyle,
+      onTraceFillStyleChange: setTraceFillStyle,
+    },
+  };
+}
