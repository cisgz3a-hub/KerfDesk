+// Render helpers for Trace dialog tests. The caller mocks the image loader and
+// the trace client; these helpers only mount the dialog and drive its controls.
+
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { expect } from 'vitest';
+import { IDENTITY_TRANSFORM, type RasterImage } from '../../core/scene';
+import { useUiStore } from '../state/ui-store';
+import { ImportImageDialog } from './ImportImageDialog';
+
+(
+  globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT?: boolean }
+).IS_REACT_ACT_ENVIRONMENT = true;
+
+export function traceDialogSeed(over: Partial<RasterImage> = {}): RasterImage {
+  return {
+    kind: 'raster-image',
+    id: 'raster-1',
+    source: 'logo.png',
+    dataUrl: 'data:image/png;base64,AAA',
+    pixelWidth: 100,
+    pixelHeight: 80,
+    bounds: { minX: 0, minY: 0, maxX: 50, maxY: 40 },
+    transform: IDENTITY_TRANSFORM,
+    // eslint-disable-next-line no-restricted-syntax -- Scene fixture colour.
+    color: '#808080',
+    dither: 'floyd-steinberg',
+    linesPerMm: 10,
+    ...over,
+  };
+}
+
+export async function withTraceDialog(
+  run: (host: HTMLElement) => Promise<void>,
+  source: RasterImage = traceDialogSeed(),
+): Promise<void> {
+  const host = document.createElement('div');
+  document.body.appendChild(host);
+  useUiStore.getState().openImageDialog(source);
+  let root: Root | null = null;
+  await act(async () => {
+    root = createRoot(host);
+    root.render(createElement(ImportImageDialog));
+  });
+  try {
+    await run(host);
+  } finally {
+    const mounted = root as Root | null;
+    await act(async () => mounted?.unmount());
+    host.remove();
+    useUiStore.setState({ imageDialog: null });
+  }
+}
+
+export function selectByLabel(host: HTMLElement, label: string): HTMLSelectElement {
+  const select = host.querySelector(`select[aria-label="${label}"]`);
+  expect(select).toBeInstanceOf(HTMLSelectElement);
+  return select as HTMLSelectElement;
+}
+
+export function inputByLabel(host: HTMLElement, label: string): HTMLInputElement | null {
+  return host.querySelector(`input[aria-label="${label}"]`);
+}
+
+export async function changeSelect(select: HTMLSelectElement, value: string): Promise<void> {
+  await act(async () => {
+    select.value = value;
+    select.dispatchEvent(new Event('change', { bubbles: true }));
+  });
+}
+
+export async function typeNumber(input: HTMLInputElement | null, value: string): Promise<void> {
+  expect(input).toBeInstanceOf(HTMLInputElement);
+  await act(async () => {
+    if (input === null) return;
+    const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
+    setter?.call(input, value);
+    input.dispatchEvent(new Event('input', { bubbles: true }));
+  });
+}
+
+export async function waitForText(host: HTMLElement, text: string): Promise<void> {
+  await waitFor(() => expect(host.textContent ?? '').toContain(text));
+}
+
+export async function waitFor(assertion: () => void): Promise<void> {
+  let lastError: unknown;
+  for (let attempt = 0; attempt < 80; attempt += 1) {
+    try {
+      assertion();
+      return;
+    } catch (err) {
+      lastError = err;
+    }
+    await act(async () => {
+      await new Promise((resolve) => window.setTimeout(resolve, 10));
+    });
+  }
+  throw lastError;
+}
