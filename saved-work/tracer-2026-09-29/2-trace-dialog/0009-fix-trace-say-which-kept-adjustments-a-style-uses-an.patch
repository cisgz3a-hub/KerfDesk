+++ b/src/ui/trace/trace-setting-edits.ts
@@ -0,0 +1,114 @@
+// Which of the kept trace adjustments the selected style uses. The dialog keeps
+// one set of overrides across style changes, but each style reads only the
+// controls it shows; the rest stay unused until a style with those controls
+// is selected again.
+
+import type { TraceOptions } from '../../core/trace';
+import {
+  mergeLightBurnTraceSettings,
+  traceDetectionMode,
+  type LightBurnTraceSettingOverrides,
+} from './trace-options';
+
+type OverrideKey = keyof LightBurnTraceSettingOverrides;
+
+export type TraceSettingEdits = {
+  /** The used adjustments change what this style traces. */
+  readonly edited: boolean;
+  /** Labels of kept adjustments this style does not use. */
+  readonly unused: ReadonlyArray<string>;
+};
+
+// Listed in panel order; both sketch keys belong to the Detection control.
+const OVERRIDE_LABELS: Readonly<Record<OverrideKey, string>> = {
+  photoDetail: 'Detail',
+  photoBrightness: 'Brightness',
+  photoContrast: 'Contrast',
+  photoGamma: 'Midtones',
+  photoInvert: 'Invert',
+  edgeSensitivity: 'Sensitivity',
+  edgeDetail: 'Detail',
+  edgeMinimumLinePx: 'Minimum line',
+  detectionMode: 'Detection',
+  sketchTrace: 'Detection',
+  cutoffLuma: 'Cutoff',
+  thresholdLuma: 'Threshold',
+  despeckleMinPixels: 'Remove ink specks',
+  ignoreLessThanPixels: 'Ignore Less Than',
+  fillPinholeCracks: 'Fill tiny holes',
+  smoothness: 'Smoothness',
+  optimize: 'Optimize',
+  traceTransparency: 'Trace alpha mask',
+};
+
+const PHOTO_KEYS: ReadonlyArray<OverrideKey> = [
+  'photoDetail',
+  'photoBrightness',
+  'photoContrast',
+  'photoGamma',
+  'photoInvert',
+];
+const EDGE_KEYS: ReadonlyArray<OverrideKey> = [
+  'edgeSensitivity',
+  'edgeDetail',
+  'edgeMinimumLinePx',
+  'smoothness',
+  'optimize',
+];
+// Mask controls shared by the filled styles and Centerline.
+const MASK_KEYS: ReadonlyArray<OverrideKey> = [
+  'detectionMode',
+  'sketchTrace',
+  'despeckleMinPixels',
+  'fillPinholeCracks',
+  'traceTransparency',
+];
+const CONTOUR_KEYS: ReadonlyArray<OverrideKey> = ['ignoreLessThanPixels', 'smoothness', 'optimize'];
+
+export function traceSettingEdits(
+  preset: TraceOptions,
+  overrides: LightBurnTraceSettingOverrides,
+  sourceHasTransparency: boolean | undefined,
+): TraceSettingEdits {
+  const used = usedOverrideKeys(preset, overrides, sourceHasTransparency);
+  const active: Partial<Record<OverrideKey, unknown>> = {};
+  const unused = new Set<string>();
+  for (const key of Object.keys(OVERRIDE_LABELS) as OverrideKey[]) {
+    const value = overrides[key];
+    if (value === undefined) continue;
+    if (used.has(key)) active[key] = value;
+    else if (!(key === 'detectionMode' && value === 'preset')) unused.add(OVERRIDE_LABELS[key]);
+  }
+  const edited =
+    optionsKey(mergeLightBurnTraceSettings(preset, active as LightBurnTraceSettingOverrides)) !==
+    optionsKey(mergeLightBurnTraceSettings(preset, {}));
+  return { edited, unused: [...unused] };
+}
+
+function usedOverrideKeys(
+  preset: TraceOptions,
+  overrides: LightBurnTraceSettingOverrides,
+  sourceHasTransparency: boolean | undefined,
+): ReadonlySet<OverrideKey> {
+  if (preset.photoDetail !== undefined) return new Set(PHOTO_KEYS);
+  if (preset.traceMode === 'edge') return new Set(EDGE_KEYS);
+  const used = new Set<OverrideKey>(MASK_KEYS);
+  if (preset.traceMode !== 'centerline') for (const key of CONTOUR_KEYS) used.add(key);
+  // An opaque image ignores the alpha mask (trace-alpha.ts), and the band is
+  // read only by Manual detection or by the alpha mask.
+  const alphaMask =
+    sourceHasTransparency === true &&
+    (overrides.traceTransparency ?? preset.traceTransparency) === true;
+  if (!alphaMask) used.delete('traceTransparency');
+  if (alphaMask || traceDetectionMode(preset, overrides) === 'manual') {
+    used.add('cutoffLuma');
+    used.add('thresholdLuma');
+  }
+  return used;
+}
+
+function optionsKey(options: TraceOptions): string {
+  const entries = Object.entries(options).filter(([, value]) => value !== undefined);
+  entries.sort(([a], [b]) => (a < b ? -1 : 1));
+  return JSON.stringify(entries);
+}
