+const SMOOTH = TRACE_PRESETS['Smooth']!;
+const SHARP = TRACE_PRESETS['Sharp']!;
+const EDGE = TRACE_PRESETS['Edge Detection']!;
+const CENTERLINE = TRACE_PRESETS['Centerline']!;
+const PHOTO = TRACE_PRESETS['Photo shading']!;
+
+describe('which kept adjustments the selected style uses', () => {
+  it('does not call re-selecting the default detection an edit', () => {
+    expect(traceSettingEdits(LINE_ART, { detectionMode: 'preset' }, false)).toEqual({
+      edited: false,
+      unused: [],
+    });
+  });
+
+  it('keeps a manual band for later without counting it while automatic detection runs', () => {
+    const band = { cutoffLuma: 0, thresholdLuma: 150 };
+    expect(traceSettingEdits(SMOOTH, { ...band, detectionMode: 'manual' }, false)).toEqual({
+      edited: true,
+      unused: [],
+    });
+    expect(traceSettingEdits(SMOOTH, { ...band, detectionMode: 'preset' }, false)).toEqual({
+      edited: false,
+      unused: ['Cutoff', 'Threshold'],
+    });
+  });
+
+  it('counts a kept value that matches the preset as unedited until another preset differs', () => {
+    const kept = { despeckleMinPixels: LINE_ART.despeckleMinPixels! };
+    expect(traceSettingEdits(LINE_ART, kept, false).edited).toBe(false);
+    expect(traceSettingEdits(SHARP, kept, false).edited).toBe(true);
+  });
+
+  it('lists the kept adjustments a style ignores', () => {
+    expect(traceSettingEdits(EDGE, { edgeSensitivity: 80, despeckleMinPixels: 30 }, false)).toEqual(
+      { edited: true, unused: ['Remove ink specks'] },
+    );
+    expect(traceSettingEdits(LINE_ART, { edgeSensitivity: 80 }, false)).toEqual({
+      edited: false,
+      unused: ['Sensitivity'],
+    });
+    expect(
+      traceSettingEdits(CENTERLINE, { smoothness: 0.4, ignoreLessThanPixels: 9 }, false),
+    ).toEqual({ edited: false, unused: ['Ignore Less Than', 'Smoothness'] });
+    expect(
+      traceSettingEdits(PHOTO, { photoGamma: 1.4, detectionMode: 'faint-lines' }, false),
+    ).toEqual({ edited: true, unused: ['Detection'] });
+    expect(traceSettingEdits(LINE_ART, { photoInvert: true }, false)).toEqual({
+      edited: false,
+      unused: ['Invert'],
+    });
+  });
+
+  it('uses the alpha mask and its band only on an image with transparency', () => {
+    const alpha = { traceTransparency: true };
+    expect(traceSettingEdits(LINE_ART, alpha, false)).toEqual({
+      edited: false,
+      unused: ['Trace alpha mask'],
+    });
+    expect(traceSettingEdits(LINE_ART, { ...alpha, thresholdLuma: 90 }, true)).toEqual({
+      edited: true,
+      unused: [],
+    });
+  });
+});
