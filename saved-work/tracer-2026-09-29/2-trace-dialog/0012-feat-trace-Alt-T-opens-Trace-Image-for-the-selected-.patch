diff --git a/src/ui/app/tool-shortcuts.ts b/src/ui/app/tool-shortcuts.ts
new file mode 100644
index 000000000..e888cdf59
--- /dev/null
+++ b/src/ui/app/tool-shortcuts.ts
@@ -0,0 +1,62 @@
+// Tools shortcuts (WORKFLOW.md F-A15): T for canvas text, Ctrl/Cmd+R, E and L
+// for the drawing tools, Alt+M for Measure, Alt+T for Trace Image and
+// Ctrl/Cmd+Shift+B for Convert to Bitmap. Split from shortcuts.ts, which
+// keeps the File, Edit, Transform and View handlers.
+
+import type { ToolMode } from '../state/ui-store';
+import { isEditableShortcutTarget } from '../common/keyboard-targets';
+import { hasMeta, isAltLetterChord } from './shortcut-keys';
+
+export type ToolCtx = {
+  readonly setToolMode: (mode: ToolMode) => void;
+  // Ctrl/Cmd+Shift+B — LightBurn's Convert to Bitmap binding (LIGHTBURN-STUDY
+  // §7.4). The callback owns the gate (single convertible vector selected);
+  // the matcher only routes the chord.
+  readonly openConvertToBitmap: () => void;
+  // Alt+T (Option+T on macOS) — LightBurn's Trace Image binding. The callback
+  // owns the gate (a raster image selected), like the Tools command.
+  readonly openTraceImage: () => void;
+};
+
+// Ctrl/Cmd + letter arms a drawing tool, matching LightBurn (ADR-051 B7):
+// R = rectangle, E = ellipse, L = line/pen. Plain Ctrl+letter only — the Shift
+// variants belong to Save-As (S) and export-G-code (E).
+const TOOL_BINDINGS: Readonly<Record<string, ToolMode>> = {
+  r: { kind: 'draw', shape: 'rect' },
+  e: { kind: 'draw', shape: 'ellipse' },
+  l: { kind: 'draw', shape: 'polyline' },
+};
+
+// Ctrl/Cmd+Shift+B — Convert to Bitmap (LightBurn §7.4).
+function isConvertToBitmapChord(e: KeyboardEvent): boolean {
+  return hasMeta(e) && e.shiftKey && !e.altKey && e.key.toLowerCase() === 'b';
+}
+
+function isPlainLetter(e: KeyboardEvent, letter: string): boolean {
+  return !hasMeta(e) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === letter;
+}
+
+// The chords that run one action; drawing tools follow in TOOL_BINDINGS.
+function chordAction(e: KeyboardEvent, ctx: ToolCtx): (() => void) | null {
+  if (isPlainLetter(e, 't')) return () => ctx.setToolMode({ kind: 'text' });
+  if (isAltLetterChord(e, 'm')) return () => ctx.setToolMode({ kind: 'measure' });
+  if (isAltLetterChord(e, 't')) return ctx.openTraceImage;
+  if (isConvertToBitmapChord(e)) return ctx.openConvertToBitmap;
+  return null;
+}
+
+export function handleToolShortcut(e: KeyboardEvent, ctx: ToolCtx): boolean {
+  if (isEditableShortcutTarget(e.target)) return false;
+  const action = chordAction(e, ctx);
+  if (action !== null) {
+    e.preventDefault();
+    action();
+    return true;
+  }
+  if (!hasMeta(e) || e.shiftKey || e.altKey) return false;
+  const mode = TOOL_BINDINGS[e.key.toLowerCase()];
+  if (mode === undefined) return false;
+  e.preventDefault();
+  ctx.setToolMode(mode);
+  return true;
+}
