+// Alt+T (Option+T on macOS) opens Trace Image for the selected image: the
+// chord the Tools menu shows, with the same gate as that command (ADR-396).
+
+import { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import {
+  createProject,
+  IDENTITY_TRANSFORM,
+  type RasterImage,
+  type SceneObject,
+} from '../../core/scene';
+import type { PlatformAdapter } from '../../platform/types';
+import { buildAppCommands, commandById } from '../commands/command-registry';
+import { baseCtx } from '../commands/command-registry-test-helpers';
+import { useStore } from '../state';
+import { useUiStore } from '../state/ui-store';
+import { PlatformProvider } from './platform-context';
+import { useShortcuts } from './use-shortcuts';
+
+(
+  globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT?: boolean }
+).IS_REACT_ACT_ENVIRONMENT = true;
+
+const platform: PlatformAdapter = {
+  id: 'mock',
+  pickFilesForOpen: vi.fn(async () => []),
+  pickFileForSave: vi.fn(async () => null),
+  serial: { isSupported: () => false, requestPort: vi.fn(async () => null) },
+};
+
+const IMAGE: RasterImage = {
+  kind: 'raster-image',
+  id: 'photo',
+  source: 'photo.png',
+  dataUrl: 'data:image/png;base64,iVBORw0KGgo=',
+  lumaBase64: 'AAAAAA==',
+  pixelWidth: 2,
+  pixelHeight: 2,
+  bounds: { minX: 0, minY: 0, maxX: 2, maxY: 2 },
+  transform: IDENTITY_TRANSFORM,
+  color: '#000000',
+  dither: 'floyd-steinberg',
+  linesPerMm: 10,
+};
+
+const SHAPE: SceneObject = {
+  kind: 'shape',
+  id: 'box',
+  spec: { kind: 'rect', widthMm: 20, heightMm: 10, cornerRadiusMm: 0 },
+  color: '#000000',
+  bounds: { minX: 0, minY: 0, maxX: 20, maxY: 10 },
+  transform: IDENTITY_TRANSFORM,
+  paths: [],
+};
+
+function Shortcuts(): null {
+  useShortcuts();
+  return null;
+}
+
+function select(id: string | null): void {
+  const project = createProject();
+  useStore.setState({
+    project: { ...project, scene: { ...project.scene, objects: [IMAGE, SHAPE] } },
+    selectedObjectId: id,
+    additionalSelectedIds: new Set(),
+  });
+}
+
+// The chord exactly as the Tools menu labels the command, e.g. "Alt+T".
+async function pressMenuChord(init: KeyboardEventInit = {}): Promise<void> {
+  const label = commandById(buildAppCommands(baseCtx()), 'tools.trace-image').shortcut ?? '';
+  const [modifier, letter = ''] = label.split('+');
+  expect(modifier).toBe('Alt');
+  await act(async () => {
+    document.body.dispatchEvent(
+      new KeyboardEvent('keydown', {
+        key: letter.toLowerCase(),
+        code: `Key${letter}`,
+        altKey: true,
+        bubbles: true,
+        cancelable: true,
+        ...init,
+      }),
+    );
+  });
+}
+
+async function withShortcuts(run: () => Promise<void>): Promise<void> {
+  const host = document.createElement('div');
+  document.body.append(host);
+  let root: Root | null = null;
+  await act(async () => {
+    root = createRoot(host);
+    root.render(
+      <PlatformProvider adapter={platform}>
+        <Shortcuts />
+      </PlatformProvider>,
+    );
+  });
+  try {
+    await run();
+  } finally {
+    await act(async () => root?.unmount());
+    host.remove();
+  }
+}
+
+afterEach(() => {
+  useStore.getState().newProject();
+  useUiStore.setState({ textDialog: null, imageDialog: null, modalDepth: 0 });
+});
+
+describe('Alt+T opens Trace Image', () => {
+  it('opens the dialog on the selected image, from Option+T on macOS too', async () => {
+    select('photo');
+    await withShortcuts(async () => {
+      await pressMenuChord();
+      expect(useUiStore.getState().imageDialog?.source.id).toBe('photo');
+      useUiStore.setState({ imageDialog: null });
+      await pressMenuChord({ key: '†' });
+      expect(useUiStore.getState().imageDialog?.source.id).toBe('photo');
+    });
+  });
+
+  it.each([
+    ['a shape is selected', 'box'],
+    ['nothing is selected', null],
+  ])('does nothing when %s, like the disabled menu item', async (_name, id) => {
+    select(id);
+    await withShortcuts(async () => {
+      await pressMenuChord();
+      expect(useUiStore.getState().imageDialog).toBeNull();
+    });
+  });
+
+  it('waits while another dialog owns the keyboard', async () => {
+    select('photo');
+    useUiStore.setState({ modalDepth: 1 });
+    await withShortcuts(async () => {
+      await pressMenuChord();
+      expect(useUiStore.getState().imageDialog).toBeNull();
+    });
+  });
+});
