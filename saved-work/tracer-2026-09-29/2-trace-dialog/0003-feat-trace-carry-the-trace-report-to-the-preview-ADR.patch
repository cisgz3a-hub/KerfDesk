+// The ready preview keeps what the trace reported, so the dialog can show the
+// band automatic detection used and start Manual from it (ADR-396).
+
+import { describe, expect, it, vi } from 'vitest';
+
+vi.mock('./use-trace-worker-client', () => ({
+  traceImageWithFallback: vi.fn(),
+  isTraceRequestSuperseded: (error: unknown) =>
+    error instanceof Error && error.name === 'TraceRequestSupersededError',
+}));
+
+import type { RawImageData, TraceOptions } from '../../core/trace';
+import { traceImageWithFallback } from './use-trace-worker-client';
+import { runTrace } from './use-trace-preview';
+
+const img: RawImageData = { width: 2, height: 2, data: new Uint8ClampedArray(16) };
+const options: TraceOptions = {
+  numberOfColors: 2,
+  pathOmit: 8,
+  lineTolerance: 1,
+  quadraticTolerance: 1,
+  blurRadius: 0,
+  blurDelta: 0,
+  lineFilter: true,
+};
+const line = {
+  closed: false,
+  points: [
+    { x: 0, y: 0 },
+    { x: 1, y: 1 },
+  ],
+};
+
+describe('runTrace keeps the trace report', () => {
+  it('shows what automatic detection chose, including on a cropped region', async () => {
+    const report = { automaticThresholdLuma: 150 };
+    vi.mocked(traceImageWithFallback).mockResolvedValue({
+      paths: [{ color: '#000000', polylines: [line] }],
+      bounds: { minX: 0, minY: 0, maxX: 1, maxY: 1 },
+      width: 2,
+      height: 2,
+      report,
+    });
+    const setState = vi.fn();
+    const boundary = { x: 1, y: 1, width: 2, height: 2 };
+
+    await runTrace({ img, options, isCurrent: () => true, setState });
+    await runTrace({ img, options, boundary, isCurrent: () => true, setState });
+
+    expect(setState).toHaveBeenNthCalledWith(1, expect.objectContaining({ kind: 'ready', report }));
+    expect(setState).toHaveBeenNthCalledWith(2, expect.objectContaining({ kind: 'ready', report }));
+  });
+});
