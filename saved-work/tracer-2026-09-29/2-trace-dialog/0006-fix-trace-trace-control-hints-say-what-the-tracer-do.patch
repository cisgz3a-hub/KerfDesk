+import { useId } from 'react';
+
+/** One numeric trace control: a number field, a slider for short ranges, and a
+ * visible hint that describes both. */
+export function TraceNumberRow(props: {
+  readonly label: string;
+  readonly hint: string;
+  readonly min: number;
+  readonly max: number;
+  readonly step: number;
+  readonly value: number;
+  readonly unit?: 'px' | 'px²';
+  readonly onChange: (next: number) => void;
+}): JSX.Element {
+  const inputId = useId();
+  const hintId = useId();
+  const change = (raw: string): void => props.onChange(settleTraceNumber(Number(raw), props));
+  return (
+    <div className="lf-trace-number">
+      <label htmlFor={inputId}>
+        <span>{props.label}</span>
+        <span className="lf-trace-number-input">
+          <input
+            id={inputId}
+            className="lf-input"
+            type="number"
+            min={props.min}
+            max={props.max}
+            step={props.step}
+            value={props.value}
+            onChange={(e) => change(e.target.value)}
+            aria-label={`Trace ${props.label}`}
+            aria-describedby={hintId}
+            title={props.hint}
+          />
+          {props.unit === undefined ? null : <span>{props.unit}</span>}
+        </span>
+      </label>
+      {props.max <= 255 ? (
+        <input
+          type="range"
+          min={props.min}
+          max={props.max}
+          step={props.step}
+          value={props.value}
+          aria-label={`Trace ${props.label} slider`}
+          title={props.hint}
+          aria-describedby={hintId}
+          onChange={(e) => change(e.target.value)}
+        />
+      ) : null}
+      <p id={hintId}>{props.hint}</p>
+    </div>
+  );
+}
+
+// Whole-number controls round what is typed, so the field always shows the
+// value the tracer receives (the area settings are rounded when merged).
+function settleTraceNumber(
+  value: number,
+  range: { readonly min: number; readonly max: number; readonly step: number },
+): number {
+  if (!Number.isFinite(value)) return range.min;
+  const settled = Number.isInteger(range.step) ? Math.round(value) : value;
+  return Math.max(range.min, Math.min(range.max, settled));
+}
