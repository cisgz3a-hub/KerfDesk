   }
   const current =
     file === null
@@ -44,8 +55,16 @@ export function tracePreviewFacts(
   finished: FinishedTracePreview | null,
   current: TraceDetectionRequest | null,
 ): TracePreviewFacts {
-  if (finished?.report === undefined || current === null) return {};
-  return sameDetection(finished.request, current) ? { report: finished.report } : {};
+  if (finished === null || current === null || finished.request.file !== current.file) return {};
+  const source = finished.request.sourceGrid;
+  const resized =
+    source !== undefined &&
+    (source.width !== finished.grid.width || source.height !== finished.grid.height);
+  const detected = finished.report !== undefined && sameDetection(finished.request, current);
+  return {
+    ...(resized ? { workingGrid: finished.grid } : {}),
+    ...(detected ? { report: finished.report } : {}),
+  };
 }
 
