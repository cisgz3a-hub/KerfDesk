+// The Smooth and Sharp descriptions name what those presets do differently
+// from each other; these checks keep that copy true to the engine (ADR-396).
+
+import { describe, expect, it } from 'vitest';
+import { TRACE_PRESETS, type RawImageData } from '../../core/trace';
+import { prepareTraceForContour } from '../../core/trace/trace-image';
+import { fill, paper } from './trace-controls.test-support';
+
+function isInk(image: RawImageData, x: number, y: number): boolean {
+  return image.data[(y * image.width + x) * 4] === 0;
+}
+
+describe('Smooth and Sharp descriptions', () => {
+  it('Sharp keeps a single-pixel mark and a tiny hole that Smooth cleans up', () => {
+    const image = paper();
+    fill(image, 5, 5, 1, 1, [0, 0, 0]);
+    fill(image, 30, 20, 20, 20, [0, 0, 0]);
+    fill(image, 40, 30, 1, 1, [255, 255, 255]);
+    const smooth = prepareTraceForContour(image, TRACE_PRESETS['Smooth']!);
+    const sharp = prepareTraceForContour(image, TRACE_PRESETS['Sharp']!);
+    expect([smooth.prepared.width, sharp.prepared.width]).toEqual([image.width, image.width]);
+    expect([isInk(smooth.prepared, 5, 5), isInk(smooth.prepared, 40, 30)]).toEqual([false, true]);
+    expect([isInk(sharp.prepared, 5, 5), isInk(sharp.prepared, 40, 30)]).toEqual([true, false]);
+    // Both set their threshold from the image rather than a fixed band.
+    expect(smooth.report?.automaticThresholdLuma).toBeDefined();
+    expect(sharp.report?.automaticThresholdLuma).toBeDefined();
+  });
+});
