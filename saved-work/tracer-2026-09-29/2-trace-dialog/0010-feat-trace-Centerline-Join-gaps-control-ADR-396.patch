+  it('joins Centerline line ends across a gap only when Join gaps reaches it', async () => {
+    const image = paper();
+    fill(image, 5, 28, 30, 3, [0, 0, 0]);
+    fill(image, 37, 28, 30, 3, [0, 0, 0]);
+    const lines = async (options: TraceOptions): Promise<number> =>
+      (await traceImageToColoredPaths(image, options)).reduce(
+        (n, path) => n + path.polylines.length,
+        0,
+      );
+    await withControls('Centerline', async (controls) => {
+      expect(controls.number('Join gaps').value).toBe('3');
+      expect(await lines(controls.options())).toBe(2);
+      await controls.change('Join gaps', 6);
+      expect(await lines(controls.options())).toBe(1);
+      await controls.change('Join gaps', 0);
+      expect(await lines(controls.options())).toBe(2);
+      await controls.selectPreset('Line Art');
+      expect(controls.host.querySelector('[aria-label="Trace Join gaps"]')).toBeNull();
+      expect(controls.options()).toEqual(TRACE_PRESETS['Line Art']);
+      await controls.selectPreset('Centerline');
+      expect(controls.number('Join gaps').value).toBe('0');
+      await controls.reset();
+      expect(controls.options()).toEqual(TRACE_PRESETS['Centerline']);
+    });
+  });
+
