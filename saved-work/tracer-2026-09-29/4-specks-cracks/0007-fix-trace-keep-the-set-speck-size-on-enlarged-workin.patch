   if (minPixels <= 1) return image;
+  const minWorkingPixels = pixelScale > 1 ? (minPixels - 0.5) * pixelScale * pixelScale : minPixels;
   const { width: w, height: h } = image;
   const out = new Uint8ClampedArray(image.data);
   const visited = new Uint8Array(w * h);
@@ -270,7 +285,7 @@ export function despeckle(image: RawImageData, minPixels: number): RawImageData
     visited[startIdx] = 1;
     if (lumaAt(out, startIdx * 4) >= 128) continue; // background pixel — skip
     const region = bfsInkRegion(out, visited, w, h, startIdx);
-    if (region.length < minPixels) {
+    if (region.length < minWorkingPixels) {
       eraseRegion(out, region);
     }
   }
