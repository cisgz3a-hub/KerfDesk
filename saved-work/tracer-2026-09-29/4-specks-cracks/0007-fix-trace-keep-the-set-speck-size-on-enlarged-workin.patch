@@ -0,0 +1,57 @@
+// Remove ink specks counts SOURCE pixels on every route (ADR-392). Small
+// images trace on a 2x or 3x bilinear supersample, where each mark loses a
+// little area at its rounded corners. The setting must still keep an N-pixel
+// mark and remove an (N − 1)-pixel one, as the native trace does.
+
+import { describe, expect, it } from 'vitest';
+import { upscaleBy } from './auto-upscale';
+import { prepareTraceForContour, type RawImageData, type TraceOptions } from './trace-image';
+import { TRACE_PRESETS } from './trace-presets';
+
+type Mark = { readonly name: string; readonly width: number; readonly height: number };
+
+const MARKS: ReadonlyArray<Mark> = [
+  { name: '1x1', width: 1, height: 1 },
+  { name: '1x2', width: 2, height: 1 },
+  { name: '2x2', width: 2, height: 2 },
+  { name: '2x3', width: 3, height: 2 },
+  { name: '3x3', width: 3, height: 3 },
+];
+
+function markImage(mark: Mark): RawImageData {
+  const size = 24;
+  const data = new Uint8ClampedArray(size * size * 4).fill(255);
+  for (let y = 0; y < mark.height; y += 1) {
+    for (let x = 0; x < mark.width; x += 1) data.set([0, 0, 0, 255], ((8 + y) * size + 8 + x) * 4);
+  }
+  return { width: size, height: size, data };
+}
+
+function survives(mark: Mark, setting: number, scale: number): boolean {
+  const options: TraceOptions = {
+    ...TRACE_PRESETS['Line Art']!,
+    despeckleMinPixels: setting,
+    pixelScale: scale,
+  };
+  const source = markImage(mark);
+  const image = scale > 1 ? upscaleBy(source, scale) : source;
+  const { prepared } = prepareTraceForContour(image, options);
+  for (let i = 0; i < prepared.width * prepared.height; i += 1) {
+    if ((prepared.data[i * 4] ?? 255) < 128) return true;
+  }
+  return false;
+}
+
+describe('Remove ink specks on supersampled routes', () => {
+  it.each([2, 3])('keeps and removes the same marks at %sx as natively', (scale) => {
+    for (const mark of MARKS) {
+      for (let setting = 2; setting <= 10; setting += 1) {
+        const expected = mark.width * mark.height >= setting;
+        expect(survives(mark, setting, 1), `${mark.name} native at ${setting}`).toBe(expected);
+        expect(survives(mark, setting, scale), `${mark.name} at ${scale}x, ${setting}`).toBe(
+          expected,
+        );
+      }
+    }
+  });
+});
