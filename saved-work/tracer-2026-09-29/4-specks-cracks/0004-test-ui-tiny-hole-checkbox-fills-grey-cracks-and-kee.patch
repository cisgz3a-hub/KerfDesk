+// A 40 by 35 ink block with a one-pixel anti-aliased rim, as rasterised art
+// has; the rim also gives Otsu a cut between ink and paper.
+const INK_BLOCK = 42 * 37;
+
+function inkBlock(): RawImageData {
+  const image = paper();
+  fill(image, 9, 9, 42, 37, [128, 128, 128]);
+  fill(image, 10, 10, 40, 35, [0, 0, 0]);
+  return image;
+}
+
 function paper(gray = 255): RawImageData {
   const data = new Uint8ClampedArray(80 * 60 * 4);
   for (let i = 0; i < data.length; i += 4) data.set([gray, gray, gray, 255], i);
