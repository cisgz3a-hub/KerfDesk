diff --git a/src/core/trace/centerline/centerline-preset-scale.test.ts b/src/core/trace/centerline/centerline-preset-scale.test.ts
index 727aa5c6d..6b8b8ff2b 100644
--- a/src/core/trace/centerline/centerline-preset-scale.test.ts
+++ b/src/core/trace/centerline/centerline-preset-scale.test.ts
@@ -87,9 +87,9 @@ describe('Centerline preset connectivity', () => {
 
     // The 12-pixel diagonal meets Centerline's area threshold; the 11-pixel
     // diagonal and lone speck remain noise. Line Art counts the same
-    // corner-touching marks (ADR-392), so its 12 px² setting agrees.
+    // corner-touching marks (ADR-392) and, at 2 px², drops only the speck.
     expect(lowerInkPixels(preprocessForTrace(image, CENTERLINE))).toBe(12);
-    expect(lowerInkPixels(preprocessForTrace(image, TRACE_PRESETS['Line Art']!))).toBe(12);
+    expect(lowerInkPixels(preprocessForTrace(image, TRACE_PRESETS['Line Art']!))).toBe(23);
   });
 });
 
diff --git a/src/core/trace/trace-presets.ts b/src/core/trace/trace-presets.ts
index a0ec515ba..250e4e301 100644
--- a/src/core/trace/trace-presets.ts
+++ b/src/core/trace/trace-presets.ts
@@ -21,9 +21,9 @@ export const TRACE_PRESETS: Readonly<Record<string, TraceOptions>> = {
     //     brightness band, inclusive 0..128.
     //   * fixedPalette [white, black] — guarantees a 2-layer output
     //     even if the input has stray non-monochrome pixels.
-    //   * despeckleMinPixels 12 — removes connected ink blobs under
-    //     12 pixels. Kills JPEG dot artefacts that survived the
-    //     threshold.
+    //   * despeckleMinPixels 2 — removes lone 1-px ink specks only; 2 is
+    //     also the default speck size in potrace and Inkscape. At 12 it
+    //     deleted the dot of an i in text up to about 34 px tall (ADR-392).
     //   * pathOmit 16 — second-line defence: drops short paths the
     //     tracer might still emit at edges.
     numberOfColors: 2,
@@ -40,7 +40,7 @@ export const TRACE_PRESETS: Readonly<Record<string, TraceOptions>> = {
     ignoreLessThanPixels: 2,
     smoothness: 1,
     optimize: 0.2,
-    despeckleMinPixels: 12,
+    despeckleMinPixels: 2,
     // Fill hairline threshold cracks enclosed in solid ink (letter-stem
     // slivers) so they don't trace as spurious inner contours. Slivers of
     // bright paper, such as drawn white lines, stay open (ADR-392).
@@ -153,7 +153,9 @@ export const TRACE_PRESETS: Readonly<Record<string, TraceOptions>> = {
     fixedPalette: ['#ffffff', '#000000'],
     medianFilter: 'auto',
     useOtsuThreshold: true,
-    despeckleMinPixels: 24,
+    // Lone 1-px specks only; at 24 it deleted the whole letter i in 16 px
+    // text (ADR-392).
+    despeckleMinPixels: 2,
     // Same hairline-crack cleanup as Line Art; Sharp deliberately omits it
     // (pixel-fidelity preset — every notch matters, even a crack).
     fillPinholeCracks: true,
