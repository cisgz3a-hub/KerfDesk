+function isSaddle(mask: InkMask, x: number, y: number): boolean {
+  const northWest = isInk(mask, x - 1, y - 1);
+  const northEast = isInk(mask, x, y - 1);
+  return (
+    northWest !== northEast &&
+    northWest === isInk(mask, x, y) &&
+    northEast === isInk(mask, x - 1, y)
