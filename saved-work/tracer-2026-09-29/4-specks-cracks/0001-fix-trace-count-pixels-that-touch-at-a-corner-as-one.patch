+}
+
+// Square windows centred on a saddle corner, 4×4, 6×6 and 8×8 pixels. The
+// 2×2 core always holds two ink and two paper pixels, so the smallest window
+// with more of one colour decides.
+const SADDLE_WINDOW_HALF_WIDTHS = [2, 3, 4] as const;
+
+/** The turn policy at a saddle corner (x, y) on the pixel-corner lattice:
+ *  true joins the two diagonal ink pixels, false joins the two paper pixels.
+ *  Minority policy, potrace's documented default: connect whichever colour
+ *  is scarcer around the corner, so a 1-px diagonal line on paper stays one
+ *  mark and a 1-px white line through solid ink stays one gap. A full tie (a
+ *  checkerboard) joins ink, so dithered ink stays one mark instead of loose
+ *  pixels. Pixels outside the mask count as paper, as they do for the walk. */
+export function saddleJoinsInk(mask: InkMask, x: number, y: number): boolean {
+  for (const half of SADDLE_WINDOW_HALF_WIDTHS) {
+    let balance = 0;
+    for (let py = y - half; py < y + half; py += 1) {
+      for (let px = x - half; px < x + half; px += 1) balance += isInk(mask, px, py) ? 1 : -1;
+    }
+    if (balance !== 0) return balance < 0;
+  }
+  return true;
+}
+
+/** Whether paper pixel (x, y) connects to paper pixel (x + dx, y + dy) across
+ *  their shared corner (dx, dy = ±1) the way the walk connects them: only at
+ *  a saddle, where the two pixels beside that corner are ink, and only where
+ *  the walk joins paper there. Callers that group paper into regions use it
+ *  so their regions are the holes the walk traces. */
+export function paperJoinsDiagonally(
+  mask: InkMask,
+  x: number,
+  y: number,
+  dx: number,
+  dy: number,
+): boolean {
+  if (isInk(mask, x + dx, y + dy)) return false;
+  if (!isInk(mask, x + dx, y) || !isInk(mask, x, y + dy)) return false;
+  return !saddleJoinsInk(mask, x + Math.max(dx, 0), y + Math.max(dy, 0));
+}
+
+function isInk(mask: InkMask, x: number, y: number): boolean {
+  return inkAt(mask, x, y) !== 0;
+}
