diff --git a/src/core/trace/trace-diagonal-connectivity.test.ts b/src/core/trace/trace-diagonal-connectivity.test.ts
new file mode 100644
index 000000000..a1e9c4922
--- /dev/null
+++ b/src/core/trace/trace-diagonal-connectivity.test.ts
@@ -0,0 +1,99 @@
+// Pixels that touch only at a corner are one mark in every outline mode
+// (ADR-392). Before, Line Art and Smooth erased a 1-px diagonal as a row of
+// 1-px specks, and Sharp traced it as one square per pixel.
+
+import { describe, expect, it } from 'vitest';
+import type { Polyline } from '../scene';
+import type { RawImageData, TraceOptions } from './trace-image';
+import { TRACE_PRESETS } from './trace-presets';
+import { traceImageToColoredPaths } from './trace-to-paths';
+
+const OUTLINE_PRESETS = ['Line Art', 'Smooth', 'Sharp', 'Edge Detection'] as const;
+
+function canvas(size: number, paper: number): RawImageData {
+  const data = new Uint8ClampedArray(size * size * 4).fill(paper);
+  return { width: size, height: size, data };
+}
+
+function paint(image: RawImageData, x: number, y: number, luma: number): void {
+  image.data.set([luma, luma, luma, 255], (y * image.width + x) * 4);
+}
+
+// A 1-px black diagonal, 160 px long, on white paper.
+function diagonalHairline(): RawImageData {
+  const image = canvas(200, 255);
+  for (let i = 0; i < 160; i += 1) paint(image, 20 + i, 20 + i, 0);
+  return image;
+}
+
+// A black block and a pale X of two 1-px diagonals (luma 175), the kind of
+// stroke Faint lines adds to the mask.
+function paleCross(): RawImageData {
+  const image = canvas(220, 255);
+  for (let y = 10; y < 40; y += 1) {
+    for (let x = 10; x < 40; x += 1) paint(image, x, y, 0);
+  }
+  for (let i = 0; i < 90; i += 1) {
+    paint(image, 60 + i, 60 + i, 175);
+    paint(image, 160 - i, 60 + i, 175);
+  }
+  return image;
+}
+
+// Large images trace at their own resolution, where no supersampling blurs a
+// diagonal into a 4-connected band; these overrides give a small test image
+// the same route.
+const NATIVE_SCALE: Partial<TraceOptions> = {
+  supersampleContour: false,
+  autoUpscaleSmallSources: false,
+  upscaleSmallSmoothSources: false,
+};
+
+async function outlines(
+  image: RawImageData,
+  preset: string,
+  overrides: Partial<TraceOptions> = {},
+): Promise<Polyline[]> {
+  const options = TRACE_PRESETS[preset];
+  if (options === undefined) throw new Error(`missing preset ${preset}`);
+  const paths = await traceImageToColoredPaths(image, { ...options, ...overrides });
+  return paths.flatMap((path) => path.polylines);
+}
+
+function span(polyline: Polyline): { readonly min: number; readonly max: number } {
+  const xs = polyline.points.map((point) => point.x);
+  return { min: Math.min(...xs), max: Math.max(...xs) };
+}
+
+function expectOneHairlineOutline(traced: ReadonlyArray<Polyline>): void {
+  expect(traced).toHaveLength(1);
+  const outline = traced[0]!;
+  expect(outline.closed).toBe(true);
+  const { min, max } = span(outline);
+  expect(min).toBeLessThan(22);
+  expect(max).toBeGreaterThan(178);
+}
+
+describe('corner-touching pixels are one mark (ADR-392)', () => {
+  it.each(OUTLINE_PRESETS)(
+    '%s traces a 160 px diagonal hairline as one closed outline',
+    async (preset) => {
+      expectOneHairlineOutline(await outlines(diagonalHairline(), preset));
+    },
+  );
+
+  it.each(OUTLINE_PRESETS)('%s keeps the hairline whole at native scale', async (preset) => {
+    expectOneHairlineOutline(await outlines(diagonalHairline(), preset, NATIVE_SCALE));
+  });
+
+  it.each(['Line Art', 'Smooth'])(
+    '%s with Faint lines keeps a pale diagonal X as one outline',
+    async (preset) => {
+      const traced = await outlines(paleCross(), preset, { faintLineRecovery: true });
+      const onCross = traced.filter((polyline) =>
+        polyline.points.every((point) => point.x > 55 && point.y > 55),
+      );
+      expect(onCross).toHaveLength(1);
+    },
+  );
+});
