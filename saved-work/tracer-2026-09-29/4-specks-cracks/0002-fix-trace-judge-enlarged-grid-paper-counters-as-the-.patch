+  it('judges a paper pixel joined to a kept counter across a corner as that counter', () => {
+    // Solid ink with a 2×2 counter and one more paper pixel touching its
+    // corner. Ink is the majority around that corner, so the walk joins the
+    // two into one hole (ADR-392). Enlargement keeps the counter and closes
+    // the pixel; the hole is still there, so nothing is restored.
+    const source = whiteImage(8);
+    const enlarged = whiteImage(16);
+    const counter = (x: number, y: number): boolean =>
+      (x >= 2 && x <= 3 && y >= 2 && y <= 3) || (x === 4 && y === 4);
+    for (let y = 0; y < 8; y += 1) {
+      for (let x = 0; x < 8; x += 1) if (!counter(x, y)) paint(source, x, y, 0);
+    }
+    for (let y = 0; y < 16; y += 1) {
+      for (let x = 0; x < 16; x += 1) {
+        if (x < 4 || x > 7 || y < 4 || y > 7) paint(enlarged, x, y, 0);
+      }
+    }
+    const native = { image: source, prepared: source, options: LINE_ART, crackField: null };
+    const big = { image: enlarged, prepared: enlarged, options: LINE_ART, crackField: null };
+    expect(restoreEnlargedContourSupport(native, big, 2)).toBe(big);
+  });
