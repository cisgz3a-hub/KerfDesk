-function paperNeighbours(image: RawImageData, x: number, y: number): number[] {
+function paperNeighbours(mask: InkMask, x: number, y: number): number[] {
+  const indices: number[] = [];
+  if (x > 0) indices.push(y * mask.width + x - 1);
+  if (x + 1 < mask.width) indices.push(y * mask.width + x + 1);
+  if (y > 0) indices.push((y - 1) * mask.width + x);
+  if (y + 1 < mask.height) indices.push((y + 1) * mask.width + x);
+  const paper = indices.filter((index) => mask.ink[index] !== 1);
