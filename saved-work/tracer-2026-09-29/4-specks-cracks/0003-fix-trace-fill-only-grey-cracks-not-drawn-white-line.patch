   });
 });
+
+const THRESHOLD = 128;
+const MARGIN = 3;
+
+// A paper margin around the rows, so the image has paper to measure.
+function padded(rows: ReadonlyArray<string>): string[] {
+  const blank = '.'.repeat((rows[0]?.length ?? 0) + 2 * MARGIN);
+  const side = '.'.repeat(MARGIN);
+  const edge = Array.from({ length: MARGIN }, () => blank);
+  return [...edge, ...rows.map((row) => side + row + side), ...edge];
+}
+
+// The mask a threshold cut leaves, plus the luma it was cut from. '#' is ink
+// and '.' is paper; any other character is a sliver pixel whose luma comes
+// from `shades`. Sliver pixels are lighter than the threshold, so the mask
+// shows them as paper.
+function cutFromLuma(
+  rows: ReadonlyArray<string>,
+  shades: Readonly<Record<string, number>>,
+  paperLuma = WHITE,
+): { readonly image: RawImageData; readonly field: CrackSubPixelField } {
+  const framed = padded(rows);
+  const width = framed[0]?.length ?? 0;
+  const height = framed.length;
+  const lumaOf = (cell: string): number => {
+    if (cell === '#') return BLACK;
+    return shades[cell] ?? paperLuma;
+  };
+  const luma = framed.flatMap((row) => Array.from(row, lumaOf));
+  const field: CrackSubPixelField = {
+    lumaAt: (x, y) => {
+      if (x < 0 || y < 0 || x >= width || y >= height) return WHITE;
+      return luma[y * width + x] ?? WHITE;
+    },
+    thresholdAt: () => THRESHOLD,
+  };
+  const mask = framed.map((row) => row.replace(/[^#]/g, '.'));
+  return { image: imageFromRows(mask), field };
+}
+
+// The H-stem crack with its pixels marked 'c'.
+function crackRows(): string[] {
+  return withVerticalSlit(solidBlock(20, 40), 9, 2, 5, 35).map((row) => row.replaceAll('.', 'c'));
+}
+
+// A 1-px diagonal of 'c' pixels inside solid ink; its pixels touch only at
+// corners.
+function diagonalCrackRows(size: number, length: number): string[] {
+  return solidBlock(size, size).map((row, y) => {
+    if (y < MARGIN || y >= MARGIN + length) return row;
+    return `${row.slice(0, y)}c${row.slice(y + 1)}`;
+  });
+}
+
+function filledRows(
+  cut: { readonly image: RawImageData; readonly field: CrackSubPixelField },
+  withField = true,
+): string[] {
+  return rowsFromImage(fillPinholes(cut.image, 1, withField ? cut.field : undefined));
+}
+
+describe('fillPinholes with the luma before the cut (ADR-392)', () => {
+  it('fills a crack whose pixels were grey, just lighter than the threshold', () => {
+    expect(filledRows(cutFromLuma(crackRows(), { c: 150 }))).toEqual(padded(solidBlock(20, 40)));
+  });
+
+  it('keeps a white line drawn through the ink open', () => {
+    const cut = cutFromLuma(crackRows(), { c: 250 });
+    expect(filledRows(cut)).toEqual(rowsFromImage(cut.image));
+    // Without the luma (alpha masks, brightness bands) it fills, as before.
+    expect(filledRows(cut, false)).toEqual(padded(solidBlock(20, 40)));
+  });
+
+  it('keeps a sliver open when any of its pixels was paper', () => {
+    const rows = crackRows().map((row, y) => (y === 20 ? row.replaceAll('c', 'w') : row));
+    const cut = cutFromLuma(rows, { c: 150, w: 250 });
+    expect(filledRows(cut)).toEqual(rowsFromImage(cut.image));
+  });
+
+  it('measures paper from the image, so off-white paper keeps the same meaning', () => {
+    // 185 is nearer the threshold (128) than white paper (255) but nearer the
+    // paper than the threshold when the paper itself is 205.
+    expect(filledRows(cutFromLuma(crackRows(), { c: 185 }))).toEqual(padded(solidBlock(20, 40)));
+    const offWhite = cutFromLuma(crackRows(), { c: 185 }, 205);
+    expect(filledRows(offWhite)).toEqual(rowsFromImage(offWhite.image));
+  });
+
+  it('judges a diagonal white line as one sliver, not one pixel at a time', () => {
+    // 130 px long, so one sliver over the 120 px area cap: it stays open even
+    // without the luma, though each pixel alone would pass every guard.
+    const long = cutFromLuma(diagonalCrackRows(140, 130), { c: 150 });
+    expect(filledRows(long, false)).toEqual(rowsFromImage(long.image));
+    // A short one is judged by its luma: grey fills, bright stays open.
+    const grey = cutFromLuma(diagonalCrackRows(20, 12), { c: 150 });
+    expect(filledRows(grey)).toEqual(padded(solidBlock(20, 20)));
+    const bright = cutFromLuma(diagonalCrackRows(20, 12), { c: 250 });
+    expect(filledRows(bright)).toEqual(rowsFromImage(bright.image));
+  });
+});
