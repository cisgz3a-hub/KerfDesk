--- /dev/null
+++ b/src/ui/common/free-file-name.ts
@@ -0,0 +1,31 @@
+// freeFileName — the first name a save can use without replacing anything:
+// the requested name, then "name (2).ext", "name (3).ext" and so on, the way
+// desktop file managers number a copy. The caller's `isTaken` decides what
+// counts as used, for example a file already in the folder or a name the same
+// save has just written.
+
+// A bound, not a policy: it only stops a broken `isTaken` that never answers
+// "free" from looping forever. Reaching it is reported, never skipped.
+const MAX_COPY_NUMBER = 9999;
+
+export async function freeFileName(
+  requested: string,
+  isTaken: (name: string) => Promise<boolean>,
+): Promise<string> {
+  if (!(await isTaken(requested))) return requested;
+  for (let copy = 2; copy <= MAX_COPY_NUMBER; copy += 1) {
+    const candidate = numberedFileName(requested, copy);
+    if (!(await isTaken(candidate))) return candidate;
+  }
+  throw new Error(
+    `every name from ${requested} to ${numberedFileName(requested, MAX_COPY_NUMBER)} is taken`,
+  );
+}
+
+/** "logo.svg" → "logo (2).svg"; a name without an extension gets the number
+ * at the end, and a leading dot is part of the name, not an extension. */
+export function numberedFileName(name: string, copy: number): string {
+  const dot = name.lastIndexOf('.');
+  if (dot <= 0) return `${name} (${copy})`;
+  return `${name.slice(0, dot)} (${copy})${name.slice(dot)}`;
+}
