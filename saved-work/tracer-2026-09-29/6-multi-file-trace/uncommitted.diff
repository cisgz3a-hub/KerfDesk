+
+// File System Access has no exclusive create: getFileHandle(name, { create:
+// true }) opens a same-name file and createWritable then replaces it. Looking
+// without create is the only non-destructive check; NotFoundError means free
+// and TypeMismatchError means a folder already has the name.
+async function directoryHasEntry(
+  directory: FileSystemDirectoryHandle,
+  name: string,
+): Promise<boolean> {
+  try {
+    await directory.getFileHandle(name, { create: false });
+    return true;
+  } catch (err) {
+    if (errorNamed(err, 'NotFoundError')) return false;
+    if (errorNamed(err, 'TypeMismatchError')) return true;
+    throw err;
+  }
+}
+
+function errorNamed(err: unknown, name: string): boolean {
+  return typeof err === 'object' && err !== null && 'name' in err && err.name === name;
 }
 
