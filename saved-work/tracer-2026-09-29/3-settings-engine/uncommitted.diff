+import { describe, expect, it } from 'vitest';
+import { otsuThreshold } from './preprocess';
+import { preprocessForTrace, type RawImageData, type TraceOptions } from './trace-image';
+import { traceInkReport } from './trace-ink-report';
+import { TRACE_PRESETS } from './trace-presets';
+
+type Rgba = readonly [number, number, number, number];
+type Box = readonly [number, number, number, number];
+
+// White canvas with filled boxes [x0, y0, x1, y1).
+function paint(boxes: ReadonlyArray<[Box, Rgba]>): RawImageData {
+  const width = 160;
+  const height = 100;
+  const data = new Uint8ClampedArray(width * height * 4).fill(255);
+  for (const [[x0, y0, x1, y1], colour] of boxes) {
+    for (let y = y0; y < y1; y += 1) {
+      for (let x = x0; x < x1; x += 1) data.set(colour, (y * width + x) * 4);
+    }
+  }
+  return { width, height, data };
+}
+
+const preset = (name: string): TraceOptions => TRACE_PRESETS[name] as TraceOptions;
+const BLOCK: Box = [10, 10, 60, 90];
+const PALE_BAR: Box = [90, 40, 150, 48];
+// A black block and a pale bar of the same luma (172), grey or gold.
+const GREY = paint([
+  [BLOCK, [0, 0, 0, 255]],
+  [PALE_BAR, [172, 172, 172, 255]],
+]);
+const GOLD = paint([
+  [BLOCK, [0, 0, 0, 255]],
+  [PALE_BAR, [212, 175, 55, 255]],
+]);
+const LINE_ART_BAND = { kind: 'band', low: 0, high: 128 } as const;
+
+// Whether the prepared mask holds ink at the pale bar's centre.
+function barIsInk(image: RawImageData, options: TraceOptions): boolean {
+  const prepared = preprocessForTrace(image, options);
+  return (prepared.data[(44 * prepared.width + 120) * 4] ?? 255) < 128;
+}
+
