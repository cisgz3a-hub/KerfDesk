+// Enhance region re-traces a crop of the source. The crop must split ink from
+// background the way the full trace did: the automatic sketch gate and the
+// automatic (Otsu) threshold are decided once, on the whole source.
+
+import { describe, expect, it } from 'vitest';
+import type { ColoredPath } from '../scene';
+import { shouldUseSketchTrace } from './auto-sketch-trace';
+import { otsuThreshold } from './preprocess';
+import { enhanceRegionPaths, resolveRegionSourceOptions } from './region-enhance';
+import { cropRawImageData } from './trace-boundary';
+import type { RawImageData, TraceOptions } from './trace-image';
+import { TRACE_PRESETS } from './trace-presets';
+import { traceImageToColoredPaths } from './trace-to-paths';
+
+type Rgb = readonly [number, number, number];
+type Box = readonly [number, number, number, number];
+
+// White canvas with filled boxes [x0, y0, x1, y1).
+function paint(width: number, height: number, boxes: ReadonlyArray<[Box, Rgb]>): RawImageData {
+  const data = new Uint8ClampedArray(width * height * 4).fill(255);
+  for (const [[x0, y0, x1, y1], [r, g, b]] of boxes) {
+    for (let y = y0; y < y1; y += 1) {
+      for (let x = x0; x < x1; x += 1) {
+        const offset = (y * width + x) * 4;
+        data[offset] = r;
+        data[offset + 1] = g;
+        data[offset + 2] = b;
+      }
+    }
+  }
+  return { width, height, data };
+}
+
+const SMOOTH = TRACE_PRESETS['Smooth'] as TraceOptions;
+const LINE_ART = TRACE_PRESETS['Line Art'] as TraceOptions;
+const REGION = { x: 150, y: 20, width: 60, height: 60 };
+
+// A large dark block and a pale grey stroke. The whole image's Otsu cut falls
+// between the block and the grey, so the full trace leaves the stroke out; the
+// crop around the stroke alone would cut between grey and white and trace it.
+const TWO_TONES = paint(240, 100, [
+  [
+    [10, 10, 110, 90],
+    [20, 20, 20],
+  ],
+  [
+    [170, 45, 190, 55],
+    [170, 170, 170],
+  ],
+]);
+
+describe('resolveRegionSourceOptions', () => {
+  it('carries the whole image automatic threshold into the crop', () => {
+    const resolved = resolveRegionSourceOptions(TWO_TONES, SMOOTH);
+    const crop = cropRawImageData(TWO_TONES, REGION);
+    expect(resolved.sourceOtsuThreshold).toBe(otsuThreshold(TWO_TONES));
+    expect(resolved.sourceOtsuThreshold).toBeLessThan(170);
+    expect(otsuThreshold(crop)).toBeGreaterThan(170);
+  });
+
+  it('carries the whole image sketch verdict into a crop without colour', () => {
+    const colourful = paint(240, 100, [
+      [
+        [10, 10, 110, 90],
+        [200, 40, 40],
+      ],
+      [
+        [170, 45, 190, 55],
+        [0, 0, 0],
+      ],
+    ]);
+    const crop = cropRawImageData(colourful, REGION);
+    expect(shouldUseSketchTrace(crop, LINE_ART)).toBe(false);
+    const resolved = resolveRegionSourceOptions(colourful, LINE_ART);
+    expect(resolved.sourceAutoSketch).toBe(true);
+    expect(shouldUseSketchTrace(crop, resolved)).toBe(true);
+  });
+
+  it('leaves presets without an automatic threshold or gate alone', () => {
+    const resolved = resolveRegionSourceOptions(TWO_TONES, {
+      ...LINE_ART,
+      autoSketchTrace: false,
+    });
+    expect(resolved.sourceOtsuThreshold).toBeUndefined();
+    expect(resolved.sourceAutoSketch).toBeUndefined();
+  });
+});
+
+describe('enhanceRegionPaths', () => {
+  it('traces the region with the threshold the full trace used', async () => {
+    const trace = (image: RawImageData, options: TraceOptions): Promise<ColoredPath[]> =>
+      traceImageToColoredPaths(image, options);
+    const full = await trace(TWO_TONES, SMOOTH);
+    const inRegion = (paths: ReadonlyArray<ColoredPath>): number =>
+      paths
+        .flatMap((path) => path.polylines)
+        .filter((polyline) => polyline.points.every((point) => point.x > REGION.x)).length;
+    expect(inRegion(full)).toBe(0);
+    const enhanced = await enhanceRegionPaths({
+      image: TWO_TONES,
+      region: REGION,
+      fullTracePaths: full,
+      options: SMOOTH,
+      trace,
+    });
+    expect(inRegion(enhanced)).toBe(0);
+  });
+});
