@@ -0,0 +1,41 @@
+// Presets carry only settings their backend reads. The imagetracerjs-only
+// fields (pathOmit, quadraticTolerance, blurRadius, blurDelta, lineFilter)
+// feed the multi-colour imagetracerjs path, which no preset reaches, so they
+// are left out and imagetracerjs's own defaults apply there.
+
+import { describe, expect, it } from 'vitest';
+import { isBinaryContourPreset } from './contour-trace';
+import { buildImageTracerOptions } from './trace-image';
+import { TRACE_PRESETS } from './trace-presets';
+
+const IMAGETRACER_ONLY = [
+  'pathOmit',
+  'quadraticTolerance',
+  'blurRadius',
+  'blurDelta',
+  'lineFilter',
+] as const;
+
+describe('trace preset fields', () => {
+  it.each(Object.entries(TRACE_PRESETS))('%s never reaches imagetracerjs', (_name, preset) => {
+    const ownBackend =
+      preset.photoDetail !== undefined ||
+      preset.traceMode === 'centerline' ||
+      preset.traceMode === 'edge' ||
+      isBinaryContourPreset(preset);
+    expect(ownBackend).toBe(true);
+    for (const field of IMAGETRACER_ONLY) expect(preset).not.toHaveProperty(field);
+  });
+
+  it('leaves absent imagetracerjs fields to its own defaults', () => {
+    const built = buildImageTracerOptions({ numberOfColors: 4, lineTolerance: 1 });
+    // imagetracerjs applies a default only to a key that is absent.
+    for (const key of ['pathomit', 'qtres', 'blurradius', 'blurdelta', 'linefilter']) {
+      expect(built).not.toHaveProperty(key);
+    }
+    expect(built['ltres']).toBe(1);
+    expect(
+      buildImageTracerOptions({ numberOfColors: 4, lineTolerance: 1, pathOmit: 3 }),
+    ).toHaveProperty('pathomit', 3);
+  });
+});
