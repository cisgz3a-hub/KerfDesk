@@ -0,0 +1,106 @@
+import { describe, expect, it } from 'vitest';
+import type { Vec2 } from '../scene';
+import { holdSplineToBoundary } from './contour-spline-envelope';
+import type { RawImageData, TraceOptions } from './trace-image';
+import { TRACE_PRESETS } from './trace-presets';
+import { traceImageToColoredPaths } from './trace-to-paths';
+
+const A = { x: 0, y: 0 };
+const B = { x: 10, y: 0 };
+const C = { x: 10, y: 4 };
+const D = { x: 0, y: 4 };
+const VERTICES: ReadonlyArray<Vec2> = [A, B, C, D];
+
+// The ring A-B-C-D walked every 0.5 px, holding the vertices themselves.
+function boundaryAlong(offset: (x: number) => number): Vec2[] {
+  const points: Vec2[] = [A];
+  for (let x = 0.5; x < 10; x += 0.5) points.push({ x, y: offset(x) });
+  points.push(B);
+  for (let y = 0.5; y < 4; y += 0.5) points.push({ x: 10, y });
+  points.push(C);
+  for (let x = 9.5; x > 0; x -= 0.5) points.push({ x, y: 4 });
+  points.push(D);
+  for (let y = 3.5; y > 0; y -= 0.5) points.push({ x: 0, y });
+  return points;
+}
+
+function splineWith(samples: ReadonlyArray<Vec2>): Vec2[] {
+  return [A, ...samples, B, C, D];
+}
+
+describe('holdSplineToBoundary', () => {
+  it('pulls a bow off a straight boundary back onto its chord', () => {
+    const bow = [
+      { x: 2.5, y: -0.4 },
+      { x: 5, y: -0.45 },
+      { x: 7.5, y: -0.4 },
+    ];
+    const held = holdSplineToBoundary(
+      splineWith(bow),
+      VERTICES,
+      boundaryAlong(() => 0),
+      1,
+    );
+    expect(held.slice(1, 4).map((point) => [point.x, point.y])).toEqual([
+      [2.5, 0],
+      [5, 0],
+      [7.5, 0],
+    ]);
+    expect(held[0]).toBe(A);
+    expect(held[4]).toBe(B);
+  });
+
+  it('keeps a curve that stays within the boundary it replaces', () => {
+    const arc = (x: number): number => -0.5 * Math.sin((Math.PI * x) / 10);
+    const inside = { x: 5, y: -0.3 };
+    const beyond = { x: 5, y: -0.8 };
+    const held = holdSplineToBoundary(
+      splineWith([inside, beyond]),
+      VERTICES,
+      boundaryAlong(arc),
+      1,
+    );
+    expect(held[1]).toBe(inside);
+    expect(held[2]?.x).toBe(5);
+    expect(held[2]?.y).toBeCloseTo(-0.5, 9);
+  });
+
+  it('leaves chords without boundary points between their vertices alone', () => {
+    const bow = { x: 5, y: -0.45 };
+    const held = holdSplineToBoundary(splineWith([bow]), VERTICES, VERTICES, 1);
+    expect(held[1]).toBe(bow);
+  });
+});
+
+// Settings audit X1: 1-bit bars 4 and 8 px tall traced about 0.9 px too
+// wide (Smooth 1.9 px), both long edges bowing out to the spline's
+// deviation cap.
+function bar(height: number): RawImageData {
+  const width = 200;
+  const data = new Uint8ClampedArray(width * 200 * 4).fill(255);
+  for (let y = 50; y < 50 + height; y += 1) {
+    for (let x = 40; x < 160; x += 1) data.fill(0, (y * width + x) * 4, (y * width + x) * 4 + 3);
+  }
+  return { width, height: 200, data };
+}
+
+async function edgeRows(image: RawImageData, preset: string): Promise<[number, number]> {
+  const paths = await traceImageToColoredPaths(image, TRACE_PRESETS[preset] as TraceOptions);
+  const middle = paths
+    .flatMap((path) => path.polylines.flatMap((polyline) => polyline.points))
+    .filter((point) => point.x > 80 && point.x < 120);
+  const rows = middle.map((point) => point.y);
+  return [Math.min(...rows), Math.max(...rows)];
+}
+
+describe('thin 1-bit bars', () => {
+  for (const preset of ['Line Art', 'Smooth', 'Edge Detection']) {
+    for (const height of [4, 8]) {
+      it(`${preset} traces a ${height} px bar on its pixel edges`, async () => {
+        const [top, bottom] = await edgeRows(bar(height), preset);
+        expect(Math.abs(top - 50)).toBeLessThan(0.1);
+        expect(Math.abs(bottom - (50 + height))).toBeLessThan(0.1);
+      });
+    }
+  }
+});
diff --git a/src/core/trace/contour-spline-envelope.ts b/src/core/trace/contour-spline-envelope.ts
new file mode 100644
index 000000000..d0dd75cd4
--- /dev/null
+++ b/src/core/trace/contour-spline-envelope.ts
@@ -0,0 +1,130 @@
+// The legacy tail's centripetal Catmull-Rom resample passes through the
+// simplified vertices, but between two of them its shape follows the tangents
+// the neighbouring vertices set. Beside a short, sharply turning span (the
+// rounded end of a thin bar) that tangent tilts off a long straight chord, and
+// the curve bows away from the boundary until the ε deviation cap stops it: a
+// 1-bit bar 4 or 8 px tall traced with both long edges 0.45 px outside the
+// pixels (settings audit X1). The boundary between the two vertices records
+// where the edge actually runs, so a resampled point may stand off its chord
+// no farther than that boundary does around the same place along the chord.
+
+import type { Vec2 } from '../scene';
+
+// Boundary points within this distance along the chord of a resampled point
+// set its limit, in source px.
+const ENVELOPE_WINDOW_PX = 1;
+const MIN_CHORD_PX = 1e-9;
+
+type ChordEnvelope = {
+  readonly origin: Vec2;
+  readonly along: Vec2;
+  readonly across: Vec2;
+  /** Boundary points strictly between the chord's vertices, as
+   *  (along, across) offsets from the chord's start. */
+  readonly offsets: ReadonlyArray<readonly [number, number]>;
+};
+
+/** Hold every resampled point of `spline` (the resample of the closed ring
+ *  `vertices`, which it contains by reference) within the envelope that
+ *  `boundary`, the chain the vertices were simplified from, keeps around the
+ *  chord the point belongs to. Chords with no boundary point between their
+ *  vertices keep their resample unchanged. */
+export function holdSplineToBoundary(
+  spline: ReadonlyArray<Vec2>,
+  vertices: ReadonlyArray<Vec2>,
+  boundary: ReadonlyArray<Vec2>,
+  pixelScale: number,
+): Vec2[] {
+  const vertexIndex = new Map<Vec2, number>();
+  vertices.forEach((vertex, index) => vertexIndex.set(vertex, index));
+  const at = boundaryIndices(vertices, boundary);
+  const envelopes = new Map<number, ChordEnvelope | null>();
+  const window = ENVELOPE_WINDOW_PX * pixelScale;
+  let chord = -1;
+  return spline.map((point) => {
+    const index = vertexIndex.get(point);
+    if (index !== undefined) {
+      chord = index;
+      return point;
+    }
+    if (chord < 0) return point;
+    if (!envelopes.has(chord)) envelopes.set(chord, chordEnvelope(vertices, boundary, at, chord));
+    const envelope = envelopes.get(chord);
+    return envelope === null || envelope === undefined
+      ? point
+      : clampToEnvelope(point, envelope, window);
+  });
+}
+
+// Each vertex's position on the boundary: its own index when the simplifier
+// kept the boundary point itself, else the nearest boundary point (the
+// straight-run flattener moves some vertices onto a fitted line).
+function boundaryIndices(vertices: ReadonlyArray<Vec2>, boundary: ReadonlyArray<Vec2>): number[] {
+  const indexOf = new Map<Vec2, number>();
+  boundary.forEach((point, index) => indexOf.set(point, index));
+  return vertices.map((vertex) => indexOf.get(vertex) ?? nearestIndex(boundary, vertex));
+}
+
+function nearestIndex(boundary: ReadonlyArray<Vec2>, target: Vec2): number {
+  let best = 0;
+  let bestDistance = Infinity;
+  boundary.forEach((point, index) => {
+    const distance = Math.hypot(point.x - target.x, point.y - target.y);
+    if (distance < bestDistance) {
+      best = index;
+      bestDistance = distance;
+    }
+  });
+  return best;
+}
+
+function chordEnvelope(
+  vertices: ReadonlyArray<Vec2>,
+  boundary: ReadonlyArray<Vec2>,
+  at: ReadonlyArray<number>,
+  chord: number,
+): ChordEnvelope | null {
+  const start = vertices[chord] as Vec2;
+  const end = vertices[(chord + 1) % vertices.length] as Vec2;
+  const length = Math.hypot(end.x - start.x, end.y - start.y);
+  if (length < MIN_CHORD_PX) return null;
+  const along = { x: (end.x - start.x) / length, y: (end.y - start.y) / length };
+  const across = { x: -along.y, y: along.x };
+  const offsets: Array<readonly [number, number]> = [];
+  const first = at[chord] as number;
+  const last = at[(chord + 1) % vertices.length] as number;
+  for (let index = first; first !== last; ) {
+    index = (index + 1) % boundary.length;
+    if (index === last) break;
+    const point = boundary[index] as Vec2;
+    const dx = point.x - start.x;
+    const dy = point.y - start.y;
+    offsets.push([dx * along.x + dy * along.y, dx * across.x + dy * across.y]);
+  }
+  return offsets.length === 0 ? null : { origin: start, along, across, offsets };
+}
+
+// The chord itself is always inside the envelope, so a point is only ever
+// pulled toward its chord, never pushed away from it.
+function clampToEnvelope(point: Vec2, envelope: ChordEnvelope, window: number): Vec2 {
+  const { origin, along, across } = envelope;
+  const dx = point.x - origin.x;
+  const dy = point.y - origin.y;
+  const u = dx * along.x + dy * along.y;
+  const v = dx * across.x + dy * across.y;
+  let low = 0;
+  let high = 0;
+  let seen = false;
+  for (const [offsetAlong, offsetAcross] of envelope.offsets) {
+    if (Math.abs(offsetAlong - u) > window) continue;
+    seen = true;
+    low = Math.min(low, offsetAcross);
+    high = Math.max(high, offsetAcross);
+  }
+  if (!seen || (v >= low && v <= high)) return point;
+  const held = Math.min(high, Math.max(low, v));
+  return {
+    x: origin.x + along.x * u + across.x * held,
+    y: origin.y + along.y * u + across.y * held,
+  };
+}
