@@ -0,0 +1,26 @@
+import { shouldUseSketchTrace } from './auto-sketch-trace';
+import { otsuThreshold } from './preprocess';
+import { shouldTraceAlphaMask } from './trace-alpha';
+import {
+  applyImageAdjustments,
+  applyMedian,
+  isValidRawImageData,
+  type RawImageData,
+  type TraceOptions,
+} from './trace-image';
+
+/** The automatic (Otsu) threshold a trace of `image` picks, or undefined when
+ *  it would not threshold automatically. Mirrors prepareTraceForContour's
+ *  branch order (trace-image.ts). A region re-trace resolves it once on the
+ *  full source (region-enhance.ts); the dialog reports it
+ *  (trace-ink-report.ts). */
+export function automaticThresholdForTrace(
+  image: RawImageData,
+  options: TraceOptions,
+): number | undefined {
+  if (options.useOtsuThreshold !== true || !isValidRawImageData(image)) return undefined;
+  if (options.cutoffLuma !== undefined || options.thresholdLuma !== undefined) return undefined;
+  if (shouldTraceAlphaMask(image, options)) return undefined;
+  if (options.faintLineRecovery !== true && shouldUseSketchTrace(image, options)) return undefined;
+  return otsuThreshold(applyMedian(applyImageAdjustments(image, options), options.medianFilter));
+}
