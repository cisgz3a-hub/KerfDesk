@@ -0,0 +1,101 @@
+// Which path decides ink for a binary trace, and the numbers it uses, for the
+// dialog's Detection note. The operator could not tell whether Line Art's
+// automatic recovery ran: it needs colour, and greyscale art gets the
+// brightness band alone (settings audit finding 5). The branch order is
+// prepareTraceForContour's (trace-image.ts), and the gate and threshold are
+// the functions the trace itself calls.
+
+import { resolveAutoSketchSource, shouldUseSketchTrace } from './auto-sketch-trace';
+import { automaticThresholdForTrace } from './automatic-threshold';
+import { isBinaryContourPreset } from './contour-trace';
+import { shouldTraceAlphaMask, resolveTraceSourceOptions } from './trace-alpha';
+import { isValidRawImageData, type RawImageData, type TraceOptions } from './trace-image';
+
+export type TraceInkPath =
+  /** Trace alpha mask: transparency decides ink. */
+  | 'alpha'
+  /** Sketch: local contrast alone decides ink. */
+  | 'sketch'
+  /** Line Art's automatic recovery found colour: the brightness band plus
+   *  every pixel darker than its local mean. */
+  | 'automatic-detail'
+  /** Faint lines: the brightness cut plus coherent faint strokes. */
+  | 'faint-lines'
+  /** The brightness cut alone. */
+  | 'brightness';
+
+export type TraceInkCut =
+  /** Ink is every pixel whose luma (on the alpha path, 255 − alpha) lies in
+   *  low..high, both included. */
+  | { readonly kind: 'band'; readonly low: number; readonly high: number }
+  /** Ink is every pixel whose luma is below `threshold`. `automatic` when the
+   *  trace picked it (Otsu) for this image. */
+  | { readonly kind: 'below'; readonly threshold: number; readonly automatic: boolean };
+
+export type TraceInkReport = {
+  readonly path: TraceInkPath;
+  /** The solid-ink cut the path uses; null for Sketch, and when the options
+   *  set no cut at all. */
+  readonly cut: TraceInkCut | null;
+  /** Line Art's colour gate, when it chose the path: 'found' ran the
+   *  automatic recovery, 'not-found' left the brightness cut alone. */
+  readonly colourDetail: 'found' | 'not-found' | null;
+};
+
+const DEFAULT_CUTOFF_LUMA = 0;
+const DEFAULT_THRESHOLD_LUMA = 128;
+
+/** The ink path a trace of `image` (the full source) with `options` takes.
+ *  Null for traces without a single binary ink mask: Edge Detection, photo
+ *  shading and the multi-colour tracer. A trace on a resampled working grid
+ *  decides on that grid, so near the gate's edge (0.2% coloured pixels) or on
+ *  Otsu's value it can differ slightly from this report. */
+export function traceInkReport(image: RawImageData, options: TraceOptions): TraceInkReport | null {
+  if (!isValidRawImageData(image) || !hasBinaryInkMask(options)) return null;
+  const resolved = resolveAutoSketchSource(image, resolveTraceSourceOptions(image, options));
+  if (shouldTraceAlphaMask(image, resolved)) {
+    return { path: 'alpha', cut: bandCut(resolved), colourDetail: null };
+  }
+  const faintLines = resolved.faintLineRecovery === true;
+  if (!faintLines && shouldUseSketchTrace(image, resolved)) {
+    return resolved.sketchTrace === true
+      ? { path: 'sketch', cut: null, colourDetail: null }
+      : { path: 'automatic-detail', cut: bandCut(resolved), colourDetail: 'found' };
+  }
+  const gated = !faintLines && resolved.autoSketchTrace === true && resolved.sketchTrace !== true;
+  return {
+    path: faintLines ? 'faint-lines' : 'brightness',
+    cut: brightnessCut(image, resolved),
+    colourDetail: gated ? 'not-found' : null,
+  };
+}
+
+function hasBinaryInkMask(options: TraceOptions): boolean {
+  if (options.photoDetail !== undefined) return false;
+  return options.traceMode === 'centerline' || isBinaryContourPreset(options);
+}
+
+function bandCut(options: TraceOptions): TraceInkCut {
+  const cutoff = options.cutoffLuma ?? DEFAULT_CUTOFF_LUMA;
+  const threshold = options.thresholdLuma ?? DEFAULT_THRESHOLD_LUMA;
+  return {
+    kind: 'band',
+    low: clampLuma(Math.min(cutoff, threshold)),
+    high: clampLuma(Math.max(cutoff, threshold)),
+  };
+}
+
+// The same precedence as the trace's threshold step: a band, then a manual
+// threshold, then the automatic one.
+function brightnessCut(image: RawImageData, options: TraceOptions): TraceInkCut | null {
+  if (options.cutoffLuma !== undefined) return bandCut(options);
+  if (options.thresholdLuma !== undefined) {
+    return { kind: 'below', threshold: clampLuma(options.thresholdLuma), automatic: false };
+  }
+  const automatic = options.sourceOtsuThreshold ?? automaticThresholdForTrace(image, options);
+  return automatic === undefined ? null : { kind: 'below', threshold: automatic, automatic: true };
+}
+
+function clampLuma(value: number): number {
+  return Math.max(0, Math.min(255, value));
+}
