+  it('says when Line Art found no colour and kept the band alone', () => {
+    expect(traceInkReport(GREY, preset('Line Art'))).toEqual({
+      path: 'brightness',
+      cut: LINE_ART_BAND,
+      colourDetail: 'not-found',
+    });
+    expect(barIsInk(GREY, preset('Line Art'))).toBe(false);
+  });
+
+  it('says when Line Art found colour and added local detail', () => {
+    expect(traceInkReport(GOLD, preset('Line Art'))).toEqual({
+      path: 'automatic-detail',
+      cut: LINE_ART_BAND,
+      colourDetail: 'found',
+    });
+    expect(barIsInk(GOLD, preset('Line Art'))).toBe(true);
+  });
+
+  it('reports Faint lines ahead of the colour gate', () => {
+    const options = { ...preset('Line Art'), faintLineRecovery: true };
+    expect(traceInkReport(GOLD, options)).toEqual({
+      path: 'faint-lines',
+      cut: LINE_ART_BAND,
+      colourDetail: null,
+    });
+  });
+
+  it('reports the automatic threshold the trace picks, and a manual one', () => {
+    expect(traceInkReport(GREY, preset('Smooth'))).toEqual({
+      path: 'brightness',
+      cut: { kind: 'below', threshold: otsuThreshold(GREY), automatic: true },
+      colourDetail: null,
+    });
+    expect(traceInkReport(GREY, { ...preset('Smooth'), thresholdLuma: 100 })?.cut).toEqual({
+      kind: 'below',
+      threshold: 100,
+      automatic: false,
+    });
+    expect(traceInkReport(GREY, preset('Centerline'))?.cut).toEqual({
+      kind: 'below',
+      threshold: otsuThreshold(GREY),
+      automatic: true,
+    });
+  });
+
+  it('reports Sketch and the alpha mask', () => {
+    expect(traceInkReport(GREY, { ...preset('Line Art'), sketchTrace: true })).toEqual({
+      path: 'sketch',
+      cut: null,
+      colourDetail: null,
+    });
+    const cutout = paint([[BLOCK, [0, 0, 0, 0]]]);
+    expect(traceInkReport(cutout, { ...preset('Line Art'), traceTransparency: true })).toEqual({
+      path: 'alpha',
+      cut: LINE_ART_BAND,
+      colourDetail: null,
+    });
+  });
+
+  it('follows the full source verdicts a region re-trace carries', () => {
+    const region = { ...preset('Line Art'), sourceAutoSketch: true };
+    expect(traceInkReport(GREY, region)?.path).toBe('automatic-detail');
+    const threshold = { ...preset('Smooth'), sourceOtsuThreshold: 90 };
+    expect(traceInkReport(GREY, threshold)?.cut).toEqual({
+      kind: 'below',
+      threshold: 90,
+      automatic: true,
+    });
+  });
+
+  it('has no report for traces without one binary ink mask', () => {
+    expect(traceInkReport(GREY, preset('Edge Detection'))).toBeNull();
+    expect(traceInkReport(GREY, { ...preset('Line Art'), photoDetail: 60 })).toBeNull();
+    expect(traceInkReport(GREY, { ...preset('Line Art'), numberOfColors: 4 })).toBeNull();
+  });
+});
