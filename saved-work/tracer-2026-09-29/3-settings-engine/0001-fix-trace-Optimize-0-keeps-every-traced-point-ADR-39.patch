+  if (bounded < DEFAULT_OPTIMIZE) {
+    return OPTIMIZE_TOLERANCE_FLOOR + (1 - OPTIMIZE_TOLERANCE_FLOOR) * (bounded / DEFAULT_OPTIMIZE);
+  }
+  return 1 + (bounded - DEFAULT_OPTIMIZE) * OPTIMIZE_TOLERANCE_SLOPE;
 }
 
