+/** Optimize scales geometry tolerances around the established neutral 0.2.
+ *  LightBurn documents 0 as "no merging": the scale is 0 there, and the
+ *  finisher keeps every measured boundary point instead of merging points
+ *  into fewer vertices or curves. Between 0 and 0.2 the scale rises from the
+ *  floor to 1. The floor is where the fitted outline still carries fewer
+ *  points than the boundary it replaces; below it the fit's per-curve
+ *  sampling would emit more points than "no merging" does. Above 0.2 the
+ *  original slope applies unchanged. */
 export function optimizationToleranceScaleFromOptimize(optimize: number | undefined): number {
   const value = Number.isFinite(optimize) ? (optimize as number) : DEFAULT_OPTIMIZE;
   const bounded = Math.min(2, Math.max(0, value));
-  return Math.max(0.25, 1 + (bounded - DEFAULT_OPTIMIZE) * OPTIMIZE_TOLERANCE_SLOPE);
