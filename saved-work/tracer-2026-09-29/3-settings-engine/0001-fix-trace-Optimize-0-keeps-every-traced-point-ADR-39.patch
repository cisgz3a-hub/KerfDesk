+// Optimize is the node-merging control. LightBurn documents its zero as "no
+// merging" (https://docs.lightburnsoftware.com/legacy/Tools/TracingImages),
+// so at 0 every traced boundary point must stay a vertex, while the neutral
+// 0.2 keeps the established tolerances.
+
+import { describe, expect, it } from 'vitest';
+import { PERCEPTUAL_FIXTURES } from '../../__fixtures__/perceptual/shapes';
+import {
+  contourPolylinesFromMask,
+  optimizationToleranceScaleFromOptimize,
+  traceImageToContourColoredPaths,
+} from './contour-trace';
+import type { RawImageData, TraceOptions } from './trace-image';
+import { TRACE_PRESETS } from './trace-presets';
+
+const OUTLINE_PRESETS = ['Line Art', 'Smooth', 'Sharp'] as const;
+const RGBA_CHANNELS = 4;
+const INK_LEVEL = 128;
+
+function preset(name: string, optimize: number): TraceOptions {
+  return { ...(TRACE_PRESETS[name] as TraceOptions), optimize };
+}
+
+function tracedPoints(image: RawImageData, options: TraceOptions): ReadonlyArray<number> {
+  return traceImageToContourColoredPaths(image, options)
+    .flatMap((path) => path.polylines)
+    .map((polyline) => polyline.points.length);
+}
+
+function sum(values: ReadonlyArray<number>): number {
+  return values.reduce((total, value) => total + value, 0);
+}
+
+// One mid-crack vertex per ink/paper pixel edge of a binary source.
+function boundaryCracks(image: RawImageData): number {
+  const inkAt = (x: number, y: number): boolean =>
+    x >= 0 &&
+    y >= 0 &&
+    x < image.width &&
+    y < image.height &&
+    (image.data[(y * image.width + x) * RGBA_CHANNELS] ?? 255) < INK_LEVEL;
+  let cracks = 0;
+  for (let y = 0; y < image.height; y += 1) {
+    for (let x = 0; x < image.width; x += 1) {
+      if (!inkAt(x, y)) continue;
+      for (const [dx, dy] of [
+        [1, 0],
+        [-1, 0],
+        [0, 1],
+        [0, -1],
+      ] as const) {
+        if (!inkAt(x + dx, y + dy)) cracks += 1;
+      }
+    }
+  }
+  return cracks;
+}
+
+// 4x4 coverage-sampled disc: every boundary crack carries a sub-pixel
+// measurement, so the loop takes the measured (cubic-fit) tail.
+function antiAliasedDisc(size: number, radius: number): RawImageData {
+  const data = new Uint8ClampedArray(size * size * RGBA_CHANNELS);
+  const centre = size / 2;
+  for (let y = 0; y < size; y += 1) {
+    for (let x = 0; x < size; x += 1) {
+      let covered = 0;
+      for (let sy = 0; sy < 4; sy += 1) {
+        for (let sx = 0; sx < 4; sx += 1) {
+          const dx = x + (sx + 0.5) / 4 - centre;
+          const dy = y + (sy + 0.5) / 4 - centre;
+          if (Math.hypot(dx, dy) <= radius) covered += 1;
+        }
+      }
+      const value = Math.round(255 * (1 - covered / 16));
+      const base = (y * size + x) * RGBA_CHANNELS;
+      data.fill(value, base, base + 3);
+      data[base + 3] = 255;
+    }
+  }
+  return { width: size, height: size, data };
+}
+
+describe('Optimize', () => {
+  it('maps 0 to no merging and 0.2 to the neutral tolerance, rising in between', () => {
+    expect(optimizationToleranceScaleFromOptimize(0)).toBe(0);
+    expect(optimizationToleranceScaleFromOptimize(-1)).toBe(0);
+    expect(optimizationToleranceScaleFromOptimize(0.1)).toBeCloseTo(0.625, 12);
+    expect(optimizationToleranceScaleFromOptimize(0.2)).toBe(1);
+    expect(optimizationToleranceScaleFromOptimize(undefined)).toBe(1);
+    expect(optimizationToleranceScaleFromOptimize(Number.NaN)).toBe(1);
+    expect(optimizationToleranceScaleFromOptimize(2)).toBeCloseTo(2.35, 12);
+    // Any merging at all starts at the floor where fitted outlines still
+    // carry fewer points than the boundary they replace.
+    expect(optimizationToleranceScaleFromOptimize(0.01)).toBeGreaterThanOrEqual(0.25);
+    const sweep = Array.from({ length: 201 }, (_, step) =>
+      optimizationToleranceScaleFromOptimize(step / 100),
+    );
+    sweep.slice(1).forEach((scale, step) => {
+      expect(scale).toBeGreaterThan(sweep[step] as number);
+    });
+  });
+
+  it.each(OUTLINE_PRESETS)(
+    '%s keeps one vertex per boundary crack of a curved 1-bit outline at 0',
+    (name) => {
+      const disc = PERCEPTUAL_FIXTURES.find((fixture) => fixture.name === 'filled-disc');
+      expect(disc).toBeDefined();
+      const noMerging = tracedPoints(disc!.image, preset(name, 0));
+      // A closed ring repeats its start point.
+      expect(noMerging).toEqual([boundaryCracks(disc!.image) + 1]);
+      expect(sum(noMerging)).toBeGreaterThan(sum(tracedPoints(disc!.image, preset(name, 0.2))));
+    },
+  );
+
+  it.each(OUTLINE_PRESETS)(
+    '%s keeps every measured point of an anti-aliased outline at 0',
+    (name) => {
+      const radius = 60;
+      const noMerging = sum(tracedPoints(antiAliasedDisc(160, radius), preset(name, 0)));
+      const merged = sum(tracedPoints(antiAliasedDisc(160, radius), preset(name, 0.2)));
+      // Mid-crack points of a disc sit at most one pixel apart; the default
+      // fit merges them into cubics sampled more sparsely.
+      expect((2 * Math.PI * radius) / noMerging).toBeLessThan(1);
+      expect(noMerging).toBeGreaterThan(merged * 1.4);
+    },
+  );
+
+  it('keeps holes and one-pixel loops the area gate admitted', () => {
+    const size = 32;
+    const ink = new Uint8Array(size * size);
+    const fill = (x0: number, y0: number, side: number, value: number): void => {
+      for (let y = y0; y < y0 + side; y += 1) ink.fill(value, y * size + x0, y * size + x0 + side);
+    };
+    fill(4, 4, 1, 1);
+    fill(12, 12, 12, 1);
+    fill(17, 17, 1, 0);
+    const loops = contourPolylinesFromMask(
+      { width: size, height: size, ink },
+      { minAreaPx: 0, epsilonPx: 0, fitToleranceScale: 0, flattenStrength: 0 },
+    );
+    expect(loops).toHaveLength(3);
+    for (const loop of loops) {
+      expect(loop.closed).toBe(true);
+      expect(loop.points.length).toBeGreaterThanOrEqual(4);
+    }
+  });
+});
