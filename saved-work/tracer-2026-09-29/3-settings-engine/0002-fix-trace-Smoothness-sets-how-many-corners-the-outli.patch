+// Smoothness is the dialog's corner control. LightBurn's trace defaults come
+// from potrace, where the same knob is `alphamax`: 0 draws only straight
+// lines and 1.33 only curves
+// (https://docs.lightburnsoftware.com/2.1/Reference/TraceImage/,
+// https://potrace.sourceforge.net/potrace.1.html). At 1 the finisher keeps
+// its own corner model (the bend sharpener's rebuilt corners and its 60°
+// hard turns), so the default draws exactly what it drew before this
+// control reached the corners.
+//
+// Corner strength is potrace's alpha (https://potrace.sourceforge.net/potrace.pdf,
+// section 2.3.3), read on a polygon of the boundary. It is 0 for a vertex
+// within a pixel of the chord between its neighbours and approaches 4/3 as the
+// vertex stands farther off that chord. Below 1 the slider adds corners where
+// alpha >= 4s/3, so 0 makes every polygon vertex a corner. Above 1 it
+// releases corners where alpha < 4/3 * (s - 1) / 0.33 and rounds them on the
+// finished outline (contour-corner-rounding.ts). Both ramps are empty at 1.
+
+import type { Vec2 } from '../scene';
+import { simplifyChain } from './centerline';
+
+export const DEFAULT_SMOOTHNESS = 1;
+/** The dialog's maximum, LightBurn's "only curves" value. */
+export const ALL_CURVES_SMOOTHNESS = 1.33;
+export const MAX_ALPHA = 4 / 3;
+// potrace's polygon keeps each edge within half a pixel (per axis) of the
+// staircase of pixel corners, which itself sits up to half a pixel off the
+// drawn edge. The chains here are already smoothed onto the drawn edge, so a
+// one pixel tolerance reproduces potrace's polygon and its alpha values:
+// arcs of any radius read 0.86 to 1, bends with long legs more.
+export const POLYGON_TOLERANCE_PX = 1;
+const MIN_POLYGON_VERTICES = 3;
+const NO_POINTS: ReadonlySet<Vec2> = new Set();
+
+export type SmoothnessCorners = {
+  /** Corners the finishing tail pins, by reference. */
+  readonly corners: ReadonlySet<Vec2>;
+  /** The corners this Smoothness added to the finisher's own. */
+  readonly added: ReadonlySet<Vec2>;
+  /** Smoothness 0: the outline is straight lines only. */
+  readonly linesOnly: boolean;
+};
+
+/** The dialog value clamped to potrace's range; absent or non-finite is 1. */
+export function boundedSmoothness(smoothness: number | undefined): number {
+  const value = Number.isFinite(smoothness) ? (smoothness as number) : DEFAULT_SMOOTHNESS;
+  return Math.min(MAX_ALPHA, Math.max(0, value));
+}
+
+/** The alpha below which Smoothness releases a corner: none at or below 1,
+ *  every corner at the dialog's maximum. */
+export function cornerReleaseLimit(smoothness: number): number {
+  if (smoothness <= DEFAULT_SMOOTHNESS) return -Infinity;
+  if (smoothness >= ALL_CURVES_SMOOTHNESS) return Infinity;
+  return (
+    (MAX_ALPHA * (smoothness - DEFAULT_SMOOTHNESS)) / (ALL_CURVES_SMOOTHNESS - DEFAULT_SMOOTHNESS)
+  );
+}
+
+/** The finisher's corners for a closed boundary chain at this Smoothness:
+ *  below 1 every vertex of the chain's polygon strong enough for the setting
+ *  joins them. `anchors` are extra points the polygon must keep. */
+export function shapeCornersForSmoothness(
+  points: ReadonlyArray<Vec2>,
+  corners: ReadonlySet<Vec2>,
+  anchors: ReadonlySet<Vec2>,
+  smoothness: number,
+  pixelScale: number,
+): SmoothnessCorners {
+  const unchanged: SmoothnessCorners = { corners, added: NO_POINTS, linesOnly: false };
+  if (smoothness >= DEFAULT_SMOOTHNESS) return unchanged;
+  const linesOnly = smoothness <= 0;
+  const pins = anchors.size === 0 ? corners : new Set([...corners, ...anchors]);
+  const polygon = simplifyChain(points, true, POLYGON_TOLERANCE_PX * pixelScale, pins);
+  if (polygon.length < MIN_POLYGON_VERTICES) return { ...unchanged, linesOnly };
+  const added = new Set<Vec2>();
+  polygon.forEach((vertex, index) => {
+    const alpha = cornerAlpha(polygon, index, pixelScale);
+    if (alpha >= MAX_ALPHA * smoothness && !corners.has(vertex)) added.add(vertex);
+  });
+  const all = added.size === 0 ? corners : new Set([...corners, ...added]);
+  return { corners: all, added, linesOnly };
+}
+
+/** potrace's alpha at polygon vertex `index` of a closed polygon, in source
+ *  pixels: the vertex's offset from its neighbours' chord (potrace's
+ *  dpara / ddenom, with the chord measured in L1 as potrace does), mapped so
+ *  offsets up to one pixel read 0. */
+export function cornerAlpha(
+  polygon: ReadonlyArray<Vec2>,
+  index: number,
+  pixelScale: number,
+): number {
+  const count = polygon.length;
+  const prev = polygon[(index - 1 + count) % count] as Vec2;
+  const vertex = polygon[index] as Vec2;
+  const next = polygon[(index + 1) % count] as Vec2;
+  const chordL1 = pixelScale * (Math.abs(next.x - prev.x) + Math.abs(next.y - prev.y));
+  if (chordL1 === 0) return MAX_ALPHA;
+  const cross = (vertex.x - prev.x) * (next.y - prev.y) - (vertex.y - prev.y) * (next.x - prev.x);
+  const offset = Math.abs(cross) / chordL1;
+  return offset > 1 ? MAX_ALPHA * (1 - 1 / offset) : 0;
+}
