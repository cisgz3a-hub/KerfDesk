+// Smoothness above 1 releases corners (contour-smoothness.ts) and draws each
+// one the way potrace draws a curve vertex
+// (https://potrace.sourceforge.net/potrace.pdf, section 2.3.3): one cubic from
+// a point on the edge before the vertex to a point on the edge after it, its
+// controls pulled toward the vertex by the vertex's alpha. The rounding runs on
+// the finished outline, after every fitting stage, so a released corner comes
+// out as that curve and the rest of the outline does not move.
+
+import type { Vec2 } from '../scene';
+import { simplifyChain } from './centerline';
+import { POLYGON_TOLERANCE_PX, cornerAlpha, cornerReleaseLimit } from './contour-smoothness';
+
+// How far along each polygon edge the curve reaches. potrace starts it at the
+// middle of the edge; stopping a little short keeps two neighbouring curves
+// from meeting, so each keeps a piece of the edge between them.
+const ROUNDING_REACH = 0.45;
+// potrace's polygon follows the pixel staircase, so beside a diagonal edge its
+// edges are a few pixels long and the curves stay small, while an upright
+// square's edge is its whole side and the square comes out as a squircle. This
+// polygon follows the drawn edge at any angle, and without a bound a 12-point
+// star's straight sides turned into petals. At 8 source px a star keeps its
+// points (rounded) and a large square keeps its sides.
+const MAX_ROUNDING_REACH_PX = 8;
+// A curve shorter than this would not change the drawing.
+const MIN_ROUNDING_REACH_PX = 0.05;
+// The finisher's own corner tests (curve refine, chain evening and the
+// dense-loop corner detector) all start at a 60° turn.
+const HARD_TURN_RAD = (60 * Math.PI) / 180;
+// potrace clamps alpha to this range when it places a curve vertex's controls.
+const MIN_CONTROL_ALPHA = 0.55;
+const MAX_CONTROL_ALPHA = 1;
+// Each drawn step of a curve turns at most this much and runs at most this
+// far (in source px), so the curve reads as a curve at any size. Steps halve
+// the curve's parameter, so its middle is always drawn.
+const MAX_STEP_TURN_RAD = (10 * Math.PI) / 180;
+const MAX_STEP_PX = 1.5;
+const MAX_STEP_HALVINGS = 8;
+const MIN_RING_POINTS = 3;
+const SAME_POINT_PX = 1e-9;
+
+/** A point on the outline: on the segment from ring[segment] to the next. */
+type Stop = { readonly point: Vec2; readonly segment: number };
+
+type Zone = {
+  readonly vertex: number;
+  readonly start: Stop;
+  readonly end: Stop;
+  readonly alpha: number;
+};
+
+/** A ring point that remembers its index, so the polygon's vertices map back
+ *  to the ring even where the ring holds one object twice. */
+type IndexedPoint = Vec2 & { readonly index: number };
+
+/** Round the corners of a finished closed outline that `smoothness`
+ *  releases. `corners` are the corners the finishing tail pinned, matched by
+ *  position; any other vertex that turns 60° or more is a corner too.
+ *  `amount` scales the curves with the topology repair's backed-off
+ *  tolerance. The ring may repeat its first point at the end; a rounded ring
+ *  comes back without it, and a ring with nothing to round comes back as the
+ *  same array. */
+export function roundReleasedCorners(
+  ring: ReadonlyArray<Vec2>,
+  corners: ReadonlySet<Vec2>,
+  smoothness: number,
+  pixelScale: number,
+  amount = 1,
+): ReadonlyArray<Vec2> {
+  const limit = cornerReleaseLimit(smoothness);
+  if (limit === -Infinity || ring.length <= MIN_RING_POINTS) return ring;
+  const open = repeatsFirstPoint(ring) ? ring.slice(0, -1) : ring;
+  const zones = releasedZones(open, corners, limit, pixelScale, amount);
+  if (zones.length === 0) return ring;
+  const rounded = withZonesRounded(open, zones, MAX_STEP_PX * pixelScale);
+  return rounded.length < MIN_RING_POINTS ? ring : rounded;
+}
+
+function repeatsFirstPoint(ring: ReadonlyArray<Vec2>): boolean {
+  const first = ring[0] as Vec2;
+  const last = ring[ring.length - 1] as Vec2;
+  return Math.hypot(last.x - first.x, last.y - first.y) < SAME_POINT_PX;
+}
+
+function releasedZones(
+  ring: ReadonlyArray<Vec2>,
+  corners: ReadonlySet<Vec2>,
+  limit: number,
+  pixelScale: number,
+  amount: number,
+): Zone[] {
+  const candidates = cornerCandidates(ring, corners);
+  if (candidates.size === 0) return [];
+  // The polygon keeps every candidate, so each is a vertex with its own alpha
+  // and neighbours. simplifyChain returns its input objects, starting at
+  // index 0 and in ring order, so the zones come out in ring order.
+  const nodes: IndexedPoint[] = ring.map((point, index) => ({ x: point.x, y: point.y, index }));
+  const pins = new Set<Vec2>([...candidates].map((index) => nodes[index] as IndexedPoint));
+  const tolerance = POLYGON_TOLERANCE_PX * pixelScale;
+  const polygon = simplifyChain(nodes, true, tolerance, pins) as IndexedPoint[];
+  if (polygon.length < MIN_RING_POINTS) return [];
+  const arc = cumulativeLengths(ring);
+  const maxReach = MAX_ROUNDING_REACH_PX * pixelScale * amount;
+  const minReach = MIN_ROUNDING_REACH_PX * pixelScale;
+  const count = polygon.length;
+  const zones: Zone[] = [];
+  polygon.forEach((vertex, index) => {
+    if (!candidates.has(vertex.index)) return;
+    const alpha = cornerAlpha(polygon, index, pixelScale);
+    if (alpha >= limit) return;
+    const prev = (polygon[(index - 1 + count) % count] as IndexedPoint).index;
+    const next = (polygon[(index + 1) % count] as IndexedPoint).index;
+    const reachBefore = Math.min(
+      maxReach,
+      ROUNDING_REACH * amount * arcBetween(arc, prev, vertex.index),
+    );
+    const reachAfter = Math.min(
+      maxReach,
+      ROUNDING_REACH * amount * arcBetween(arc, vertex.index, next),
+    );
+    if (Math.min(reachBefore, reachAfter) < minReach) return;
+    zones.push({
+      vertex: vertex.index,
+      start: stopBefore(ring, vertex.index, reachBefore),
+      end: stopAfter(ring, vertex.index, reachAfter),
+      alpha: Math.min(MAX_CONTROL_ALPHA, Math.max(MIN_CONTROL_ALPHA, alpha)),
+    });
+  });
+  return zones;
+}
+
+// Indices of the ring's corners: the ones the tail pinned, and any other
+// vertex that turns as hard as the finisher's own corner tests.
+function cornerCandidates(ring: ReadonlyArray<Vec2>, corners: ReadonlySet<Vec2>): Set<number> {
+  const keys = new Set([...corners].map(positionKey));
+  const candidates = new Set<number>();
+  ring.forEach((point, index) => {
+    const pinned = corners.has(point) || keys.has(positionKey(point));
+    if (pinned || turnAt(ring, index) >= HARD_TURN_RAD) candidates.add(index);
+  });
+  return candidates;
+}
+
+// The measured tail resamples its cubics into new points, so pinned corners
+// come back as equal coordinates rather than the same objects.
+function positionKey(point: Vec2): string {
+  return `${point.x},${point.y}`;
+}
+
+function turnAt(ring: ReadonlyArray<Vec2>, index: number): number {
+  const count = ring.length;
+  const prev = ring[(index - 1 + count) % count] as Vec2;
+  const point = ring[index] as Vec2;
+  const next = ring[(index + 1) % count] as Vec2;
+  const inX = point.x - prev.x;
+  const inY = point.y - prev.y;
+  const outX = next.x - point.x;
+  const outY = next.y - point.y;
+  return Math.abs(Math.atan2(inX * outY - inY * outX, inX * outX + inY * outY));
+}
+
+// arc[i] is the outline length from ring[0] to ring[i]; the last entry is
+// the whole ring.
+function cumulativeLengths(ring: ReadonlyArray<Vec2>): number[] {
+  const arc = [0];
+  ring.forEach((point, index) => {
+    const next = ring[(index + 1) % ring.length] as Vec2;
+    arc.push((arc[index] as number) + Math.hypot(next.x - point.x, next.y - point.y));
+  });
+  return arc;
+}
+
+function arcBetween(arc: ReadonlyArray<number>, from: number, to: number): number {
+  const total = arc[arc.length - 1] as number;
+  const length = (arc[to] as number) - (arc[from] as number);
+  return length > 0 ? length : length + total;
+}
+
+function stopBefore(ring: ReadonlyArray<Vec2>, vertex: number, reach: number): Stop {
+  const count = ring.length;
+  let index = vertex;
+  let remaining = reach;
+  for (let step = 0; step < count; step += 1) {
+    const prev = (index - 1 + count) % count;
+    const from = ring[index] as Vec2;
+    const to = ring[prev] as Vec2;
+    const length = Math.hypot(to.x - from.x, to.y - from.y);
+    if (length >= remaining) return { point: lerp(from, to, remaining / length), segment: prev };
+    remaining -= length;
+    index = prev;
+  }
+  return { point: ring[vertex] as Vec2, segment: (vertex - 1 + count) % count };
+}
+
+function stopAfter(ring: ReadonlyArray<Vec2>, vertex: number, reach: number): Stop {
+  const count = ring.length;
+  let index = vertex;
+  let remaining = reach;
+  for (let step = 0; step < count; step += 1) {
+    const next = (index + 1) % count;
+    const from = ring[index] as Vec2;
+    const to = ring[next] as Vec2;
+    const length = Math.hypot(to.x - from.x, to.y - from.y);
+    if (length >= remaining) return { point: lerp(from, to, remaining / length), segment: index };
+    remaining -= length;
+    index = next;
+  }
+  return { point: ring[vertex] as Vec2, segment: vertex };
+}
+
+function lerp(from: Vec2, to: Vec2, t: number): Vec2 {
+  return { x: from.x + (to.x - from.x) * t, y: from.y + (to.y - from.y) * t };
+}
+
+// Each zone's curve replaces the ring points between its two stops; the ring
+// points between one zone's end and the next zone's start stay as they are.
+function withZonesRounded(
+  ring: ReadonlyArray<Vec2>,
+  zones: ReadonlyArray<Zone>,
+  maxStep: number,
+): Vec2[] {
+  const count = ring.length;
+  const out: Vec2[] = [];
+  zones.forEach((zone, index) => {
+    appendCurve(out, ring, zone, maxStep);
+    const next = zones[(index + 1) % zones.length] as Zone;
+    const kept = (next.start.segment - zone.end.segment + count) % count;
+    for (let step = 1; step <= kept; step += 1) {
+      out.push(ring[(zone.end.segment + step) % count] as Vec2);
+    }
+  });
+  return withoutRepeats(out);
+}
+
+// potrace's curve vertex: the controls sit alpha of the way from each end
+// toward the vertex (potrace measures from the neighbouring vertex, 0.5 +
+// alpha / 2 of the way, which is the same point from the edge's middle). Here
+// they run along the outline's own direction at each end, so the curve leaves
+// the kept outline without a kink even where that outline bends.
+function appendCurve(out: Vec2[], ring: ReadonlyArray<Vec2>, zone: Zone, maxStep: number): void {
+  const count = ring.length;
+  const { start, end, alpha } = zone;
+  const vertex = ring[zone.vertex] as Vec2;
+  const into = direction(ring[start.segment] as Vec2, ring[(start.segment + 1) % count] as Vec2);
+  const away = direction(ring[end.segment] as Vec2, ring[(end.segment + 1) % count] as Vec2);
+  const reachIn = alpha * Math.hypot(vertex.x - start.point.x, vertex.y - start.point.y);
+  const reachOut = alpha * Math.hypot(vertex.x - end.point.x, vertex.y - end.point.y);
+  const curve: Cubic = [
+    start.point,
+    { x: start.point.x + into.x * reachIn, y: start.point.y + into.y * reachIn },
+    { x: end.point.x - away.x * reachOut, y: end.point.y - away.y * reachOut },
+    end.point,
+  ];
+  out.push(start.point);
+  appendSteps(out, curve, 0, 1, maxStep, 0);
+  out.push(end.point);
+}
+
+type Cubic = readonly [Vec2, Vec2, Vec2, Vec2];
+
+// The inner points of the span t0..t1, halving it until each step is short
+// and turns little.
+function appendSteps(
+  out: Vec2[],
+  curve: Cubic,
+  t0: number,
+  t1: number,
+  maxStep: number,
+  halvings: number,
+): void {
+  if (halvings >= MAX_STEP_HALVINGS) return;
+  const from = cubicPoint(curve, t0);
+  const to = cubicPoint(curve, t1);
+  const long = Math.hypot(to.x - from.x, to.y - from.y) > maxStep;
+  if (!long && tangentTurn(curve, t0, t1) <= MAX_STEP_TURN_RAD) return;
+  const middle = (t0 + t1) / 2;
+  appendSteps(out, curve, t0, middle, maxStep, halvings + 1);
+  out.push(cubicPoint(curve, middle));
+  appendSteps(out, curve, middle, t1, maxStep, halvings + 1);
+}
+
+function tangentTurn(curve: Cubic, t0: number, t1: number): number {
+  const a = cubicTangent(curve, t0);
+  const b = cubicTangent(curve, t1);
+  return Math.abs(Math.atan2(a.x * b.y - a.y * b.x, a.x * b.x + a.y * b.y));
+}
+
+function cubicTangent([p0, p1, p2, p3]: Cubic, t: number): Vec2 {
+  const u = 1 - t;
+  const a = 3 * u * u;
+  const b = 6 * u * t;
+  const c = 3 * t * t;
+  return {
+    x: a * (p1.x - p0.x) + b * (p2.x - p1.x) + c * (p3.x - p2.x),
+    y: a * (p1.y - p0.y) + b * (p2.y - p1.y) + c * (p3.y - p2.y),
+  };
+}
+
+function direction(from: Vec2, to: Vec2): Vec2 {
+  const length = Math.hypot(to.x - from.x, to.y - from.y);
+  return length === 0
+    ? { x: 0, y: 0 }
+    : { x: (to.x - from.x) / length, y: (to.y - from.y) / length };
+}
+
+function cubicPoint([p0, p1, p2, p3]: Cubic, t: number): Vec2 {
+  const u = 1 - t;
+  const a = u * u * u;
+  const b = 3 * u * u * t;
+  const c = 3 * u * t * t;
+  const d = t * t * t;
+  return {
+    x: a * p0.x + b * p1.x + c * p2.x + d * p3.x,
+    y: a * p0.y + b * p1.y + c * p2.y + d * p3.y,
+  };
+}
+
+function withoutRepeats(points: ReadonlyArray<Vec2>): Vec2[] {
+  const out: Vec2[] = [];
+  for (const point of points) {
+    const last = out[out.length - 1];
+    if (last !== undefined && Math.hypot(point.x - last.x, point.y - last.y) < SAME_POINT_PX) {
+      continue;
+    }
+    out.push(point);
+  }
+  const first = out[0];
+  const last = out[out.length - 1];
+  if (first !== undefined && last !== undefined && out.length > 1) {
+    if (Math.hypot(first.x - last.x, first.y - last.y) < SAME_POINT_PX) out.pop();
+  }
+  return out;
+}
