--- /dev/null
+++ b/src/core/trace/contour-smoothness.test.ts
@@ -0,0 +1,224 @@
+// Smoothness follows potrace's alphamax, as LightBurn documents it: 0 draws
+// only lines, 1.33 only curves, and 1 keeps the finisher's own corners. It
+// must act on 1-bit and anti-aliased art alike.
+
+import { describe, expect, it } from 'vitest';
+import type { Vec2 } from '../scene';
+import { boundedSmoothness, shapeCornersForSmoothness } from './contour-smoothness';
+import { traceImageToContourColoredPaths } from './contour-trace';
+import { traceImageToEdgePaths } from './edge-trace';
+import type { RawImageData, TraceOptions } from './trace-image';
+import { TRACE_PRESETS } from './trace-presets';
+
+const RGBA_CHANNELS = 4;
+const SWEEP = [0, 0.3, 0.6, 0.83, 1, 1.33] as const;
+// A drawn corner: a vertex that turns at least this much and carries at least
+// half of all the turning within this arc length on either side of it. A
+// polygon's vertices and a spline's corners qualify; the evenly turning
+// samples of a curve do not.
+const CORNER_TURN_RAD = (10 * Math.PI) / 180;
+const CORNER_SHARE = 0.5;
+const CORNER_WINDOW_PX = 2;
+
+type Inside = (x: number, y: number) => boolean;
+
+// Coverage-sampled render: 1 sample per pixel is 1-bit art, 4x4 is
+// anti-aliased art whose boundary takes the measured (cubic-fit) tail.
+function render(size: number, inside: Inside, samples: number): RawImageData {
+  const data = new Uint8ClampedArray(size * size * RGBA_CHANNELS);
+  for (let y = 0; y < size; y += 1) {
+    for (let x = 0; x < size; x += 1) {
+      let covered = 0;
+      for (let sy = 0; sy < samples; sy += 1) {
+        for (let sx = 0; sx < samples; sx += 1) {
+          if (inside(x + (sx + 0.5) / samples, y + (sy + 0.5) / samples)) covered += 1;
+        }
+      }
+      const value = Math.round(255 * (1 - covered / (samples * samples)));
+      const base = (y * size + x) * RGBA_CHANNELS;
+      data.fill(value, base, base + 3);
+      data[base + 3] = 255;
+    }
+  }
+  return { width: size, height: size, data };
+}
+
+const square =
+  (x0: number, y0: number, side: number): Inside =>
+  (x, y) =>
+    x >= x0 && x < x0 + side && y >= y0 && y < y0 + side;
+
+const disc =
+  (cx: number, cy: number, radius: number): Inside =>
+  (x, y) =>
+    Math.hypot(x - cx, y - cy) <= radius;
+
+function star(cx: number, cy: number, outer: number, inner: number, tips: number): Inside {
+  return (x, y) => {
+    const angle = Math.atan2(y - cy, x - cx);
+    const sector = (2 * Math.PI) / tips;
+    const phase = Math.abs((((angle % sector) + sector) % sector) / sector - 0.5) * 2;
+    // Radius along straight edges between tips (phase 1) and notches (0).
+    const tip = { x: outer, y: 0 };
+    const notch = { x: inner * Math.cos(sector / 2), y: inner * Math.sin(sector / 2) };
+    const t = 1 - phase;
+    const edgeX = tip.x + (notch.x - tip.x) * t;
+    const edgeY = tip.y + (notch.y - tip.y) * t;
+    return Math.hypot(x - cx, y - cy) <= Math.hypot(edgeX, edgeY);
+  };
+}
+
+function lineArt(smoothness: number): TraceOptions {
+  return { ...(TRACE_PRESETS['Line Art'] as TraceOptions), smoothness };
+}
+
+function outline(image: RawImageData, smoothness: number): ReadonlyArray<ReadonlyArray<Vec2>> {
+  return traceImageToContourColoredPaths(image, lineArt(smoothness))
+    .flatMap((path) => path.polylines)
+    .map((polyline) => polyline.points);
+}
+
+function drawnCorners(rings: ReadonlyArray<ReadonlyArray<Vec2>>): number {
+  let corners = 0;
+  for (const points of rings) {
+    const ring = points.slice(0, -1);
+    const turns = ring.map((_, index) => turnAt(ring, index));
+    turns.forEach((turn, index) => {
+      if (turn < CORNER_TURN_RAD) return;
+      const nearby =
+        turn + turningWithin(ring, turns, index, -1) + turningWithin(ring, turns, index, 1);
+      if (turn >= CORNER_SHARE * nearby) corners += 1;
+    });
+  }
+  return corners;
+}
+
+function turnAt(ring: ReadonlyArray<Vec2>, index: number): number {
+  const prev = ring[(index - 1 + ring.length) % ring.length] as Vec2;
+  const at = ring[index] as Vec2;
+  const next = ring[(index + 1) % ring.length] as Vec2;
+  const inX = at.x - prev.x;
+  const inY = at.y - prev.y;
+  const outX = next.x - at.x;
+  const outY = next.y - at.y;
+  return Math.abs(Math.atan2(inX * outY - inY * outX, inX * outX + inY * outY));
+}
+
+// The turning of the vertices within CORNER_WINDOW_PX of arc length of
+// `index`, walking one way round the ring.
+function turningWithin(
+  ring: ReadonlyArray<Vec2>,
+  turns: ReadonlyArray<number>,
+  index: number,
+  step: 1 | -1,
+): number {
+  const count = ring.length;
+  let total = 0;
+  let travelled = 0;
+  let at = index;
+  for (let visited = 1; visited < count; visited += 1) {
+    const next = (at + step + count) % count;
+    const a = ring[at] as Vec2;
+    const b = ring[next] as Vec2;
+    travelled += Math.hypot(b.x - a.x, b.y - a.y);
+    if (travelled > CORNER_WINDOW_PX) break;
+    total += turns[next] as number;
+    at = next;
+  }
+  return total;
+}
+
+function pointCount(rings: ReadonlyArray<ReadonlyArray<Vec2>>): number {
+  return rings.reduce((total, ring) => total + ring.length, 0);
+}
+
+function fingerprint(rings: ReadonlyArray<ReadonlyArray<Vec2>>): string {
+  return rings
+    .map((ring) => ring.map((p) => `${p.x.toFixed(3)},${p.y.toFixed(3)}`).join(' '))
+    .join('|');
+}
+
+const ART = [
+  { name: '1-bit', samples: 1 },
+  { name: 'anti-aliased', samples: 4 },
+] as const;
+
+describe('Smoothness', () => {
+  it('clamps to the potrace range and treats a missing value as 1', () => {
+    expect(boundedSmoothness(undefined)).toBe(1);
+    expect(boundedSmoothness(Number.NaN)).toBe(1);
+    expect(boundedSmoothness(-0.5)).toBe(0);
+    expect(boundedSmoothness(0.3)).toBe(0.3);
+    expect(boundedSmoothness(2)).toBeCloseTo(4 / 3, 12);
+  });
+
+  it('hands the finisher its own corners back at 1', () => {
+    const points = Array.from({ length: 40 }, (_, index) => ({
+      x: 10 * Math.cos(index / 6),
+      y: 10 * Math.sin(index / 6),
+    }));
+    const corners = new Set([points[3] as Vec2]);
+    const shaped = shapeCornersForSmoothness(points, corners, new Set(), 1, 1);
+    expect(shaped.corners).toBe(corners);
+    expect(shaped.added.size).toBe(0);
+  });
+
+  it.each(ART)('draws only straight lines at 0 on $name art', ({ samples }) => {
+    const image = render(128, disc(64, 64, 44), samples);
+    const lines = outline(image, 0);
+    const curves = outline(image, 1);
+    // A polygon: one point per vertex, where the default spends several on
+    // each curved span.
+    expect(pointCount(lines) * 2).toBeLessThan(pointCount(curves));
+    for (const ring of lines) {
+      for (let index = 1; index < ring.length; index += 1) {
+        const a = ring[index - 1] as Vec2;
+        const b = ring[index] as Vec2;
+        expect(Math.hypot(b.x - a.x, b.y - a.y)).toBeGreaterThan(1);
+      }
+    }
+  });
+
+  it.each(ART)('rounds every corner of a square at 1.33 on $name art', ({ samples }) => {
+    const image = render(128, square(24, 24, 80), samples);
+    expect(drawnCorners(outline(image, 1))).toBe(4);
+    const rounded = outline(image, 1.33);
+    expect(drawnCorners(rounded)).toBe(0);
+    // Visibly round: the outline passes about 1.4 px inside each corner.
+    const nearest = Math.min(
+      ...rounded.flat().map((point) => Math.hypot(point.x - 24, point.y - 24)),
+    );
+    expect(nearest).toBeGreaterThan(1);
+    expect(nearest).toBeLessThan(2);
+  });
+
+  it.each(ART)('draws fewer corners as Smoothness rises on $name art', ({ samples }) => {
+    const image = render(160, star(80, 80, 70, 30, 7), samples);
+    const corners = SWEEP.map((smoothness) => drawnCorners(outline(image, smoothness)));
+    corners.slice(1).forEach((count, index) => {
+      expect(count).toBeLessThanOrEqual(corners[index] as number);
+    });
+    expect(corners[SWEEP.length - 1]).toBe(0);
+    expect(corners[0]).toBeGreaterThan(corners[SWEEP.indexOf(1)] as number);
+  });
+
+  it.each(ART)('draws a different outline at every sampled value on $name art', ({ samples }) => {
+    const shapes = [star(60, 60, 50, 22, 5), disc(150, 60, 30), square(110, 120, 60)];
+    const image = render(200, (x, y) => shapes.some((inside) => inside(x, y)), samples);
+    const outlines = new Set(SWEEP.map((smoothness) => fingerprint(outline(image, smoothness))));
+    expect(outlines.size).toBe(SWEEP.length);
+  });
+
+  it('reaches the Edge Detection outlines', () => {
+    const image = render(128, square(24, 24, 80), 4);
+    const edge = (smoothness: number): ReadonlyArray<ReadonlyArray<Vec2>> =>
+      traceImageToEdgePaths(image, {
+        ...(TRACE_PRESETS['Edge Detection'] as TraceOptions),
+        smoothness,
+      })
+        .flatMap((path) => path.polylines)
+        .map((polyline) => polyline.points);
+    expect(drawnCorners(edge(1))).toBeGreaterThan(drawnCorners(edge(1.33)));
+    expect(fingerprint(edge(0))).not.toBe(fingerprint(edge(1)));
+  });
+});
