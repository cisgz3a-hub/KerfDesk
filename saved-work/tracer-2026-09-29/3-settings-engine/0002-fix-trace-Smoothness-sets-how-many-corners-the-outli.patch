@@ -0,0 +1,144 @@
+// Above 1, Smoothness rounds the corners it releases on the finished outline,
+// the way potrace draws a curve vertex, and leaves the rest of the outline as
+// the finisher drew it.
+
+import { describe, expect, it } from 'vitest';
+import type { Vec2 } from '../scene';
+import { roundReleasedCorners } from './contour-corner-rounding';
+
+type Outline = { readonly ring: Vec2[]; readonly corners: Set<Vec2> };
+
+// A finished outline through `vertices`: a point about every pixel, with each
+// vertex pinned as a corner the way the finishing tail pins its corners.
+function outlineThrough(vertices: ReadonlyArray<Vec2>): Outline {
+  const ring: Vec2[] = [];
+  const corners = new Set<Vec2>();
+  vertices.forEach((from, index) => {
+    const to = vertices[(index + 1) % vertices.length] as Vec2;
+    const steps = Math.round(Math.hypot(to.x - from.x, to.y - from.y));
+    for (let step = 0; step < steps; step += 1) {
+      const t = step / steps;
+      const point = { x: from.x + (to.x - from.x) * t, y: from.y + (to.y - from.y) * t };
+      if (step === 0) corners.add(point);
+      ring.push(point);
+    }
+  });
+  return { ring, corners };
+}
+
+const SQUARE = [
+  { x: 20, y: 20 },
+  { x: 100, y: 20 },
+  { x: 100, y: 100 },
+  { x: 20, y: 100 },
+];
+
+// The square with a shallow bend in its top side: potrace's alpha is about
+// 0.86 at the bend and about 1.28 at the square's corners.
+const BENT_SQUARE = [
+  { x: 20, y: 20 },
+  { x: 60, y: 20 },
+  { x: 100, y: 26 },
+  { x: 100, y: 100 },
+  { x: 20, y: 100 },
+];
+
+function largestTurnDeg(ring: ReadonlyArray<Vec2>): number {
+  let largest = 0;
+  ring.forEach((point, index) => {
+    const prev = ring[(index - 1 + ring.length) % ring.length] as Vec2;
+    const next = ring[(index + 1) % ring.length] as Vec2;
+    const inX = point.x - prev.x;
+    const inY = point.y - prev.y;
+    const outX = next.x - point.x;
+    const outY = next.y - point.y;
+    const turn = Math.abs(Math.atan2(inX * outY - inY * outX, inX * outX + inY * outY));
+    largest = Math.max(largest, (turn * 180) / Math.PI);
+  });
+  return largest;
+}
+
+// How far the outline passes from a point, over its segments.
+function distanceToOutline(ring: ReadonlyArray<Vec2>, target: Vec2): number {
+  let best = Infinity;
+  ring.forEach((from, index) => {
+    const to = ring[(index + 1) % ring.length] as Vec2;
+    const dx = to.x - from.x;
+    const dy = to.y - from.y;
+    const lengthSq = dx * dx + dy * dy;
+    const raw =
+      lengthSq === 0 ? 0 : ((target.x - from.x) * dx + (target.y - from.y) * dy) / lengthSq;
+    const t = Math.min(1, Math.max(0, raw));
+    best = Math.min(best, Math.hypot(from.x + dx * t - target.x, from.y + dy * t - target.y));
+  });
+  return best;
+}
+
+describe('roundReleasedCorners', () => {
+  it('returns the same outline at and below 1', () => {
+    const { ring, corners } = outlineThrough(SQUARE);
+    for (const smoothness of [0, 0.55, 1]) {
+      expect(roundReleasedCorners(ring, corners, smoothness, 1)).toBe(ring);
+    }
+  });
+
+  it('draws every corner of a square as one curve at the maximum', () => {
+    const { ring, corners } = outlineThrough(SQUARE);
+    const rounded = roundReleasedCorners(ring, corners, 1.33, 1);
+    expect(largestTurnDeg(ring)).toBe(90);
+    // Each drawn step of a curve turns at most 10°.
+    expect(largestTurnDeg(rounded)).toBeLessThanOrEqual(10 + 1e-9);
+    // alpha clamps to 1, so both controls sit on the corner and the curve
+    // over the 8 px reach passes 8 * sqrt(2) / 8 px inside it.
+    for (const corner of SQUARE) {
+      expect(distanceToOutline(rounded, corner)).toBeCloseTo(Math.SQRT2, 6);
+    }
+    // The middle of each side is not touched.
+    expect(rounded).toContain(ring[40]);
+    expect(rounded).toContain(ring[120]);
+  });
+
+  it('releases weak corners before strong ones', () => {
+    const { ring, corners } = outlineThrough(BENT_SQUARE);
+    const bend = BENT_SQUARE[1] as Vec2;
+    const squareCorner = BENT_SQUARE[0] as Vec2;
+    // 1.2 releases alpha below 0.81: neither corner.
+    expect(roundReleasedCorners(ring, corners, 1.2, 1)).toBe(ring);
+    // 1.25 releases alpha below 1.01: the bend, not the square's corners.
+    const some = roundReleasedCorners(ring, corners, 1.25, 1);
+    expect(distanceToOutline(some, bend)).toBeGreaterThan(0.05);
+    expect(distanceToOutline(some, squareCorner)).toBe(0);
+    // The maximum releases every corner.
+    const all = roundReleasedCorners(ring, corners, 1.33, 1);
+    expect(distanceToOutline(all, squareCorner)).toBeGreaterThan(1);
+  });
+
+  it('finds pinned corners by position when the tail resampled them', () => {
+    const { ring, corners } = outlineThrough(BENT_SQUARE);
+    const copies = new Set([...corners].map((corner) => ({ x: corner.x, y: corner.y })));
+    expect(roundReleasedCorners(ring, copies, 1.25, 1)).toEqual(
+      roundReleasedCorners(ring, corners, 1.25, 1),
+    );
+  });
+
+  it('rounds less when the topology repair backs the tolerance off', () => {
+    const { ring, corners } = outlineThrough(SQUARE);
+    const half = roundReleasedCorners(ring, corners, 1.33, 1, 0.5);
+    expect(distanceToOutline(half, SQUARE[0] as Vec2)).toBeCloseTo(Math.SQRT2 / 2, 6);
+  });
+
+  it('accepts a ring that repeats its first point', () => {
+    const { ring, corners } = outlineThrough(SQUARE);
+    const closed = [...ring, { x: (ring[0] as Vec2).x, y: (ring[0] as Vec2).y }];
+    expect(roundReleasedCorners(closed, corners, 1.33, 1)).toEqual(
+      roundReleasedCorners(ring, corners, 1.33, 1),
+    );
+    expect(roundReleasedCorners(closed, corners, 1, 1)).toBe(closed);
+  });
+
+  it('keeps the curve in source pixels on a supersampled outline', () => {
+    const scaled = outlineThrough(SQUARE.map((vertex) => ({ x: vertex.x * 2, y: vertex.y * 2 })));
+    const rounded = roundReleasedCorners(scaled.ring, scaled.corners, 1.33, 2);
+    expect(distanceToOutline(rounded, { x: 40, y: 40 })).toBeCloseTo(2 * Math.SQRT2, 6);
+  });
+});
