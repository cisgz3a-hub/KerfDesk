{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kerfdesk-desktop-licensing",
  "account_id": "10d5d0bdb9bf11ca0468db275a787e20",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "license.kerfdesk.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "vars": {
    "LICENSING_ENABLED": "true",
    "PAYMENTS_ENABLED": "false",
    "PAYMENT_PROVIDER": "paddle",
    "PADDLE_CHECKOUT_URL": "https://kerfdesk.com/buy.html",
    // The key the SIGNING_PRIVATE_JWK secret signs with; public/desktop-licence-keys.json
    // pins its public half. A deploy deletes plain-text variables set only in the
    // dashboard, so it lives here.
    "SIGNING_KEY_ID": "entitlement-2026-09",
  },
  "durable_objects": {
    "bindings": [{ "name": "LICENSE_AUTHORITY", "class_name": "LicenseAuthority" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseAuthority"] }],
  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "WEBHOOK_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 },
    },
    {
      "name": "TRIAL_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
