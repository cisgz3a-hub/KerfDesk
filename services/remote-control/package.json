{
  "name": "@kerfdesk/remote-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "test": "pnpm build && node --test --test-concurrency=2 test/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p app/tsconfig.json",
    "lint": "eslint .",
    "format:check": "node scripts/generate-touch-ui.mjs --check && node scripts/generate-scanner-decoder.mjs --check && node scripts/build-app.mjs --check && prettier --check .",
    "license-check": "node ../../scripts/check-licenses.mjs && node scripts/generate-notices.mjs --check",
    "generate:notices": "node scripts/generate-notices.mjs",
    "generate:scanner": "node scripts/generate-scanner-decoder.mjs",
    "build:app": "node scripts/build-app.mjs",
    "build:app-icons": "node scripts/build-app-icons.mjs",
    "build": "node scripts/generate-touch-ui.mjs --check && node scripts/generate-scanner-decoder.mjs --check && node scripts/build-app.mjs --check && wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "node scripts/generate-touch-ui.mjs --check && node scripts/generate-scanner-decoder.mjs --check && node scripts/build-app.mjs --check && node scripts/preflight-deploy.mjs && wrangler deploy",
    "generate:touch": "node scripts/generate-touch-ui.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@nuintun/qrcode": "5.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.1",
    "@types/node": "24.12.0",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "globals": "15.15.0",
    "miniflare": "5.20260930.0-alpha",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.4",
    "wrangler": "4.145.0"
  }
}
