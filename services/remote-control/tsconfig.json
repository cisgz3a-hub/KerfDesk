{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "../../electron/mcp/backend.ts",
    "../../electron/mcp/server.ts",
    "../../electron/mcp/input-schemas.ts",
    "../../electron/mcp/output-schemas.ts",
    "../../electron/mcp/tool-info.ts"
  ]
}
