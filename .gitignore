# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Vite / Vitest
.vite/
coverage/

# Playwright browser artifacts
test-results/
playwright-report/
blob-report/

# Cloudflare wrangler (pages dev) — cache + temp worker shims
.wrangler/

# Perceptual test harness — opt-in render dumps (PERCEPTUAL_ARTIFACTS=1)
perceptual-artifacts/

# Trace audit harness — opt-in render dumps (TRACE_AUDIT=1)
trace-audit-artifacts/
cnc-audit-artifacts/

# Trace fixtures — local user assets (logos/photos), not committed
fixtures/*.png
fixtures/*.jpg
fixtures/*.jpeg
fixtures/*.webp

# Electron / electron-builder
release/
dist-electron/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*~

# Local Claude / planning artifacts that should not ship to the repo
.claude/

# Codex agent worktrees — full working copies of this repo, checked out
# beside it. Not cosmetic: `prettier --check .` reads .gitignore, so this
# line is what keeps `pnpm format:check` from walking every copy. ESLint
# does NOT read .gitignore — it needs its own entry in eslint.config.mjs.
.codex-worktrees/

# Local reference repos for study only
references/
